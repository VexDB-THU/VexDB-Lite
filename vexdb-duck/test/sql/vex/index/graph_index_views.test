# name: test/sql/vex/index/graph_index_views.test
# description: Test views and CTEs with graph index
# group: [vex]

require vex

# ============================================================
# Setup
# ============================================================
statement ok
CREATE TABLE items (id INTEGER, name VARCHAR, vec FLOAT[3]);

statement ok
CREATE INDEX idx_items ON items USING GRAPH_INDEX (vec);

statement ok
INSERT INTO items VALUES
  (1, 'a', [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, 'b', [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, 'c', [0.0, 0.0, 1.0]::FLOAT[3]),
  (4, 'd', [0.7, 0.7, 0.0]::FLOAT[3]),
  (5, 'e', [0.0, 0.7, 0.7]::FLOAT[3]);

# ============================================================
# Test 1: Simple view on ANN query
# ============================================================
statement ok
CREATE VIEW v_near_origin AS
SELECT id, name FROM items
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3])
LIMIT 3;

query IT
SELECT * FROM v_near_origin ORDER BY id;
----
1	a
4	d
5	e

statement ok
DROP VIEW v_near_origin;

# ============================================================
# Test 2: View survives data changes
# ============================================================
statement ok
CREATE VIEW v_near_x AS
SELECT id FROM items
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3])
LIMIT 2;

query I
SELECT id FROM v_near_x;
----
1
4

# Insert a closer vector
statement ok
INSERT INTO items VALUES (6, 'f', [0.95, 0.05, 0.0]::FLOAT[3]);

# View should reflect new data
query I
SELECT id FROM v_near_x;
----
1
6

statement ok
DROP VIEW v_near_x;

# ============================================================
# Test 3: Nested CTE
# ============================================================
query I
WITH nearest AS (
  SELECT id, name FROM items
  ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOAT[3])
  LIMIT 3
),
filtered AS (
  SELECT id FROM nearest WHERE id > 2
)
SELECT id FROM filtered ORDER BY id;
----
4
5

# ============================================================
# Test 4: View with JOIN
# ============================================================
statement ok
CREATE TABLE categories (id INTEGER, cat VARCHAR);

statement ok
INSERT INTO categories VALUES (1, 'X'), (2, 'Y'), (3, 'Z'), (4, 'X'), (5, 'Y'), (6, 'X');

query IT
SELECT n.id, c.cat FROM (
  SELECT id FROM items ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3
) n JOIN categories c ON n.id = c.id
ORDER BY n.id;
----
1	X
4	X
6	X

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE categories;

statement ok
DROP TABLE items;
