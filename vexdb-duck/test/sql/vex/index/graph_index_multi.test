# name: test/sql/vex/index/graph_index_multi.test
# description: Test multiple graph indexes on different columns of the same table
# group: [vex]

require vex

# Create table with two vector columns of different dimensions
statement ok
CREATE TABLE multi_vec (id INTEGER, vec1 FLOAT[3], vec2 FLOAT[4]);

# Insert data where vec1 and vec2 represent independent vector spaces
statement ok
INSERT INTO multi_vec VALUES
  (1,  [1.0, 0.0, 0.0]::FLOAT[3], [0.0, 0.0, 0.0, 1.0]::FLOAT[4]),
  (2,  [0.9, 0.1, 0.0]::FLOAT[3], [0.0, 0.0, 1.0, 0.0]::FLOAT[4]),
  (3,  [0.0, 1.0, 0.0]::FLOAT[3], [0.0, 1.0, 0.0, 0.0]::FLOAT[4]),
  (4,  [0.0, 0.0, 1.0]::FLOAT[3], [1.0, 0.0, 0.0, 0.0]::FLOAT[4]),
  (5,  [0.5, 0.5, 0.0]::FLOAT[3], [0.0, 0.5, 0.5, 0.0]::FLOAT[4]),
  (6,  [0.0, 0.5, 0.5]::FLOAT[3], [0.5, 0.0, 0.0, 0.5]::FLOAT[4]),
  (7,  [0.5, 0.0, 0.5]::FLOAT[3], [0.5, 0.5, 0.0, 0.0]::FLOAT[4]),
  (8,  [0.3, 0.3, 0.3]::FLOAT[3], [0.25, 0.25, 0.25, 0.25]::FLOAT[4]),
  (9,  [0.1, 0.1, 0.8]::FLOAT[3], [0.8, 0.1, 0.1, 0.0]::FLOAT[4]),
  (10, [0.8, 0.1, 0.1]::FLOAT[3], [0.0, 0.1, 0.1, 0.8]::FLOAT[4]);

# Create GRAPH_INDEX on vec1
statement ok
CREATE INDEX idx_vec1 ON multi_vec USING GRAPH_INDEX (vec1);

# Create GRAPH_INDEX on vec2
statement ok
CREATE INDEX idx_vec2 ON multi_vec USING GRAPH_INDEX (vec2);

# Verify both indexes exist
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name IN ('idx_vec1', 'idx_vec2');
----
2

# =============================================================================
# Search on vec1 (3D) - closest to [1,0,0] should be id=1
# =============================================================================
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec1, [1.0, 0.0, 0.0]::FLOAT[3])
LIMIT 1;
----
1

# Search on vec1 - closest to [0,1,0] should be id=3
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec1, [0.0, 1.0, 0.0]::FLOAT[3])
LIMIT 1;
----
3

# =============================================================================
# Search on vec2 (4D) - closest to [0,0,0,1] should be id=1
# Note: id=1 has vec2=[0,0,0,1] which is exact match
# =============================================================================
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec2, [0.0, 0.0, 0.0, 1.0]::FLOAT[4])
LIMIT 1;
----
1

# Search on vec2 - closest to [1,0,0,0] should be id=4
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec2, [1.0, 0.0, 0.0, 0.0]::FLOAT[4])
LIMIT 1;
----
4

# =============================================================================
# Verify independence: top-1 for vec1 and vec2 return different ids
# Closest to [0,0,1] in vec1 is id=4, but closest to [0,0,1,0] in vec2 is id=2
# =============================================================================
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec1, [0.0, 0.0, 1.0]::FLOAT[3])
LIMIT 1;
----
4

query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec2, [0.0, 0.0, 1.0, 0.0]::FLOAT[4])
LIMIT 1;
----
2

# =============================================================================
# Drop idx_vec1, verify idx_vec2 still works
# =============================================================================
statement ok
DROP INDEX idx_vec1;

# idx_vec1 should be gone
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_vec1';
----
0

# idx_vec2 should still exist
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_vec2';
----
1

# Search on vec2 should still work after dropping idx_vec1
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec2, [1.0, 0.0, 0.0, 0.0]::FLOAT[4])
LIMIT 1;
----
4

query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec2, [0.0, 0.0, 0.0, 1.0]::FLOAT[4])
LIMIT 1;
----
1

# Search on vec1 should still work (just without index acceleration)
query I
SELECT id FROM multi_vec
ORDER BY l2_distance(vec1, [1.0, 0.0, 0.0]::FLOAT[3])
LIMIT 1;
----
1

# =============================================================================
# Drop idx_vec2 and verify clean state
# =============================================================================
statement ok
DROP INDEX idx_vec2;

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name IN ('idx_vec1', 'idx_vec2');
----
0

# Cleanup
statement ok
DROP TABLE multi_vec;
