# name: test/sql/vex/index/graph_index_optimizer_explain.test
# description: Verify optimizer replaces plan with COLUMN_DATA_GET for all distance metrics and patterns
# group: [vex]

require vex

# This file exercises optimizer rewrites; force HNSW path regardless of table
# size by disabling the brute-force threshold (small test tables would otherwise
# fall under the default threshold and skip the rewrite entirely).
statement ok
SET vex_brute_force_threshold = 0;

# ============================================================
# Setup: L2 metric (default)
# ============================================================
statement ok
CREATE TABLE t_l2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_l2 VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.5, 0.5, 0.0]),
  (5, [0.0, 0.5, 0.5]),
  (6, [0.5, 0.0, 0.5]),
  (7, [0.3, 0.3, 0.3]),
  (8, [0.9, 0.1, 0.0]),
  (9, [0.1, 0.9, 0.0]),
  (10, [0.0, 0.1, 0.9]);

statement ok
CREATE INDEX idx_l2 ON t_l2 USING GRAPH_INDEX (vec);

# ============================================================
# Test 1: L2 EXPLAIN should show COLUMN_DATA_GET (not SCAN)
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 2: L2 result correctness
# ============================================================
query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]), id LIMIT 3;
----
1
8
4

# ============================================================
# Test 3: list_distance (alias for l2) should also trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY list_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 4: <-> operator should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY vec <-> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Setup: Cosine metric
# ============================================================
statement ok
CREATE TABLE t_cos (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_cos VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.7, 0.7, 0.0]),
  (5, [0.0, 0.7, 0.7]),
  (6, [0.7, 0.0, 0.7]),
  (7, [0.5, 0.5, 0.5]),
  (8, [0.95, 0.05, 0.0]),
  (9, [0.05, 0.95, 0.0]),
  (10, [0.0, 0.05, 0.95]);

statement ok
CREATE INDEX idx_cos ON t_cos USING GRAPH_INDEX (vec) WITH (metric='cosine');

# ============================================================
# Test 5: Cosine EXPLAIN should show COLUMN_DATA_GET
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 6: Cosine result correctness
# ============================================================
query I
SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]), id LIMIT 3;
----
1
8
4

# ============================================================
# Test 7: list_cosine_distance should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY list_cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 8: <=> operator should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY vec <=> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 9: Metric mismatch - l2 query on cosine index should NOT use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Setup: Inner Product metric
# ============================================================
statement ok
CREATE TABLE t_ip (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_ip VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.7, 0.7, 0.0]),
  (5, [0.0, 0.7, 0.7]),
  (6, [0.7, 0.0, 0.7]),
  (7, [0.5, 0.5, 0.5]),
  (8, [0.9, 0.1, 0.0]),
  (9, [0.1, 0.9, 0.0]),
  (10, [0.0, 0.1, 0.9]);

statement ok
CREATE INDEX idx_ip ON t_ip USING GRAPH_INDEX (vec) WITH (metric='ip');

# ============================================================
# Test 10: IP with DESC should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) DESC LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 11: IP result correctness (DESC = highest similarity first)
# ============================================================
# Note: tie-breaking by id ascending so the result is deterministic regardless
# of HNSW traversal order.
query I
SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) DESC, id LIMIT 3;
----
1
8
4

# ============================================================
# Test 12: IP with ASC should NOT trigger optimizer (wrong order)
# ============================================================
query II
EXPLAIN SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) ASC LIMIT 3;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 13: FLOAT[N] vector type should work
# ============================================================
statement ok
CREATE TABLE t_alias (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_alias VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]), (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_alias ON t_alias USING GRAPH_INDEX (vec);

query II
EXPLAIN SELECT id FROM t_alias ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_alias ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

# ============================================================
# Test 14: Prepared statement (parameter binding)
# Parameters are substituted as constants before optimization, so the index IS used.
# ============================================================
statement ok
PREPARE ann_query AS SELECT id FROM t_l2 ORDER BY l2_distance(vec, $1::FLOAT[3]), id LIMIT 3;

query I
EXECUTE ann_query([1.0, 0.0, 0.0]);
----
1
8
4

statement ok
DEALLOCATE ann_query;

# ============================================================
# Test 15: LIMIT with OFFSET
# ============================================================
query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]), id LIMIT 2 OFFSET 1;
----
8
4

# ============================================================
# Test 16: SELECT * (all columns) with optimizer
# ============================================================
query II
EXPLAIN SELECT * FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM (SELECT * FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2);
----
1
8

# ============================================================
# Test 17: VARCHAR string cast to FLOAT[N] should use index
# At pre-optimize stage, '[1,0,0]'::FLOAT[3] is still
# BOUND_CAST(BOUND_CONSTANT(VARCHAR)) — constant folding
# hasn't run yet. The optimizer must handle this.
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY l2_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]), id LIMIT 3;
----
1
8
4

# ============================================================
# Test 18: <-> operator with VARCHAR cast should use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY vec <-> '[1.0, 0.0, 0.0]'::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_l2 ORDER BY vec <-> '[1.0, 0.0, 0.0]'::FLOAT[3] , id LIMIT 3;
----
1
8
4

# ============================================================
# Test 19: <-> operator without explicit cast should use index
# DuckDB core resolves <-> to list_distance which casts
# FLOAT[N] to FLOAT[] (LIST). The optimizer must handle the
# LIST target type in constant folding.
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY vec <-> '[1.0, 0.0, 0.0]' LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_l2 ORDER BY vec <-> '[1.0, 0.0, 0.0]' , id LIMIT 3;
----
1
8
4

# ============================================================
# Test 20: Cosine with VARCHAR cast should use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY cosine_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_cos ORDER BY cosine_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) , id LIMIT 3;
----
1
8
4

# ============================================================
# Test 21: <=> operator with VARCHAR cast should use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY vec <=> '[1.0, 0.0, 0.0]'::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 22: IP with VARCHAR cast and DESC should use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_ip ORDER BY inner_product(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) DESC LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I
SELECT id FROM t_ip ORDER BY inner_product(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) DESC, id LIMIT 3;
----
1
8
4

# ============================================================
# Test 23: Multiple indexes on same column with different metrics
# Should pick the correct index matching the distance function.
# ============================================================
statement ok
CREATE TABLE t_multi (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_multi VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.5, 0.5, 0.0]),
  (5, [0.9, 0.1, 0.0]);

statement ok
CREATE INDEX idx_multi_cos ON t_multi USING GRAPH_INDEX (vec) WITH (metric='cosine');

statement ok
CREATE INDEX idx_multi_l2 ON t_multi USING GRAPH_INDEX (vec) WITH (metric='l2');

statement ok
CREATE INDEX idx_multi_ip ON t_multi USING GRAPH_INDEX (vec) WITH (metric='ip');

query II
EXPLAIN SELECT id FROM t_multi ORDER BY l2_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query II
EXPLAIN SELECT id FROM t_multi ORDER BY cosine_distance(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query II
EXPLAIN SELECT id FROM t_multi ORDER BY inner_product(vec, '[1.0, 0.0, 0.0]'::FLOAT[3]) DESC LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 24: No LIMIT → should NOT use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]);
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 25: Metric mismatch → should NOT use index
# (Index is L2, query uses cosine)
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 26: Prepared statement with parameter → SHOULD use index
# (Parameters are substituted before optimization)
# ============================================================
statement ok
PREPARE ann_prep AS SELECT id FROM t_l2 ORDER BY l2_distance(vec, $1::FLOAT[3]), id LIMIT 3;

query I
EXECUTE ann_prep([1.0, 0.0, 0.0]);
----
1
8
4

statement ok
DEALLOCATE ann_prep;

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_l2;

statement ok
DROP TABLE t_cos;

statement ok
DROP TABLE t_ip;

statement ok
DROP TABLE t_alias;

statement ok
DROP TABLE t_multi;
