# name: test/sql/vex/index/graph_index_param_validation.test
# description: Test index creation parameter validation (TAPD Bug 1077654)
# group: [vex]

require vex

statement ok
CREATE TABLE t_val (id BIGINT, v FLOAT[4]);

statement ok
INSERT INTO t_val SELECT i, [(i*0.1)::FLOAT, (i*0.2)::FLOAT, (i*0.3)::FLOAT, (i*0.4)::FLOAT]::FLOAT[4] FROM range(100) t(i);

# ============================================================
# threads parameter validation
# ============================================================

# threads = -1 should fail
statement error
CREATE INDEX idx_neg ON t_val USING GRAPH_INDEX (v) WITH (threads = -1);
----
threads

# threads = 0 should fail
statement error
CREATE INDEX idx_zero ON t_val USING GRAPH_INDEX (v) WITH (threads = 0);
----
threads

# threads = 10000000 should fail
statement error
CREATE INDEX idx_huge ON t_val USING GRAPH_INDEX (v) WITH (threads = 10000000);
----
threads

# threads = 'aaa' should fail
statement error
CREATE INDEX idx_str ON t_val USING GRAPH_INDEX (v) WITH (threads = 'aaa');
----
threads

# threads = 1 should succeed
statement ok
CREATE INDEX idx_ok1 ON t_val USING GRAPH_INDEX (v) WITH (threads = 1);

statement ok
DROP INDEX idx_ok1;

# threads = 4 should succeed
statement ok
CREATE INDEX idx_ok4 ON t_val USING GRAPH_INDEX (v) WITH (threads = 4);

statement ok
DROP INDEX idx_ok4;

# ============================================================
# m parameter validation
# ============================================================

# m = 0 should fail
statement error
CREATE INDEX idx_m0 ON t_val USING GRAPH_INDEX (v) WITH (m = 0);
----
m

# m = 1 should fail
statement error
CREATE INDEX idx_m1 ON t_val USING GRAPH_INDEX (v) WITH (m = 1);
----
m

# m = 200 should fail
statement error
CREATE INDEX idx_m200 ON t_val USING GRAPH_INDEX (v) WITH (m = 200);
----
m

# m = 8 should succeed
statement ok
CREATE INDEX idx_m8 ON t_val USING GRAPH_INDEX (v) WITH (m = 8);

statement ok
DROP INDEX idx_m8;

# ============================================================
# ef_construction parameter validation
# ============================================================

# ef_construction = 0 should fail
statement error
CREATE INDEX idx_ef0 ON t_val USING GRAPH_INDEX (v) WITH (ef_construction = 0);
----
ef_construction

# ef_construction = -1 should fail
statement error
CREATE INDEX idx_efn ON t_val USING GRAPH_INDEX (v) WITH (ef_construction = -1);
----
ef_construction

# ef_construction = 50000 should fail
statement error
CREATE INDEX idx_ef50k ON t_val USING GRAPH_INDEX (v) WITH (ef_construction = 50000);
----
ef_construction

# ef_construction = 200 should succeed
statement ok
CREATE INDEX idx_ef200 ON t_val USING GRAPH_INDEX (v) WITH (ef_construction = 200);

statement ok
DROP INDEX idx_ef200;

# ============================================================
# String input validation (unified error messages)
# ============================================================

# m = 'aaa' should fail with our error message
statement error
CREATE INDEX idx_m_str ON t_val USING GRAPH_INDEX (v) WITH (m = 'aaa');
----
must be a valid integer

# ef_construction = 'aaa' should fail
statement error
CREATE INDEX idx_ef_str ON t_val USING GRAPH_INDEX (v) WITH (ef_construction = 'aaa');
----
must be a valid integer

# pq_m = 'aaa' should fail
statement error
CREATE INDEX idx_pq_str ON t_val USING GRAPH_INDEX (v) WITH (quantizer = 'pq', pq_m = 'aaa');
----
must be a valid integer

# pq_m = -1 should show correct negative value (not uint32 overflow)
statement error
CREATE INDEX idx_pq_neg ON t_val USING GRAPH_INDEX (v) WITH (quantizer = 'pq', pq_m = -1);
----
got -1

# ============================================================
# pq_m = 0 should succeed (auto-select via AutoSelectM)
# Bug 1077893: default is 0, explicit 0 should also be allowed
# ============================================================
statement ok
CREATE INDEX idx_pq0 ON t_val USING GRAPH_INDEX (v) WITH (quantizer = 'pq', pq_m = 0);

statement ok
DROP INDEX idx_pq0;

# ============================================================
# Unknown parameters should be rejected (Bug 1077895)
# ============================================================

# Single unknown parameter
statement error
CREATE INDEX idx_unk1 ON t_val USING GRAPH_INDEX (v) WITH (abc = 123);
----
unknown option

# Unknown parameter mixed with valid ones
statement error
CREATE INDEX idx_unk2 ON t_val USING GRAPH_INDEX (v) WITH (m = 16, unknown_param = 'hello');
----
unknown option

# Typo in parameter name
statement error
CREATE INDEX idx_unk3 ON t_val USING GRAPH_INDEX (v) WITH (ef_constuction = 200);
----
unknown option

# Valid parameters should still work
statement ok
CREATE INDEX idx_valid ON t_val USING GRAPH_INDEX (v) WITH (m = 16, ef_construction = 200, metric = 'cosine');

statement ok
DROP INDEX idx_valid;

# Clean up
statement ok
DROP TABLE t_val;
