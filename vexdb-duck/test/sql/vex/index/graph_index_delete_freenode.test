# name: test/sql/vex/index/graph_index_delete_freenode.test
# description: Verify synchronous FreeNode in Delete - node_count correctness and allocator segment reclamation
# group: [vex]

require vex

# ============================================================
# Test 1: Delete down to 1 node — node_count must not double-decrement to 0
# (node_count==0 would cause Search to return empty)
# ============================================================

statement ok
CREATE TABLE t1 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx1 ON t1 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t1 WHERE id = 1;

# If node_count was double-decremented to 0, this would return 0 rows
query I
SELECT count(*) FROM (SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOAT[3]) LIMIT 1);
----
1

query I
SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOAT[3]) LIMIT 1;
----
2

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: Delete all but one from a larger set
# ============================================================

statement ok
CREATE TABLE t2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]),
  (4, [0.5, 0.5, 0.0]::FLOAT[3]),
  (5, [0.0, 0.5, 0.5]::FLOAT[3]);

statement ok
CREATE INDEX idx2 ON t2 USING GRAPH_INDEX (vec);

# Delete 4 of 5 nodes
statement ok
DELETE FROM t2 WHERE id IN (1, 2, 3, 4);

# Must still find the remaining node
query I
SELECT id FROM t2 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
5

# Insert after heavy delete — allocator should reuse freed segments
statement ok
INSERT INTO t2 VALUES (6, [0.1, 0.1, 0.1]::FLOAT[3]);

query I
SELECT count(*) FROM (SELECT id FROM t2 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2);
----
2

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: Delete all nodes — search should return empty, not crash
# ============================================================

statement ok
CREATE TABLE t3 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx3 ON t3 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t3;

query I
SELECT count(*) FROM (SELECT id FROM t3 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) LIMIT 5);
----
0

# Insert after deleting all — fresh start on same allocator
statement ok
INSERT INTO t3 VALUES (3, [0.5, 0.5, 0.5]::FLOAT[3]);

query I
SELECT id FROM t3 ORDER BY l2_distance(vec, [0.5, 0.5, 0.5]::FLOAT[3]) LIMIT 1;
----
3

statement ok
DROP TABLE t3;

