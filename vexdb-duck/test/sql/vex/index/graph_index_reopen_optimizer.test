# name: test/sql/vex/index/graph_index_reopen_optimizer.test
# description: ANN query after DB reopen must still go through VEX_INDEX_SCAN
# group: [vex]

require vex

load __TEST_DIR__/graph_index_reopen_optimizer.db

statement ok
CREATE TABLE items (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO items VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]),
  (4, [0.9, 0.1, 0.0]::FLOAT[3]),
  (5, [0.0, 0.9, 0.1]::FLOAT[3]),
  (6, [0.1, 0.0, 0.9]::FLOAT[3]);

statement ok
CREATE INDEX idx ON items USING GRAPH_INDEX (vec);

# Sanity: optimizer kicks in before restart
query II
EXPLAIN SELECT id FROM items ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

statement ok
CHECKPOINT;

restart

# Index should still be visible in catalog after reopen
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# Key assertion: optimizer must still rewrite ANN to VEX_INDEX_SCAN even though
# the index is lazy-deserialized (unbound) until something triggers Bind().
query II
EXPLAIN SELECT id FROM items ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# And the result must be correct
query I
SELECT id FROM items ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]), id LIMIT 3;
----
1
4
6
