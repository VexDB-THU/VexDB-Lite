# name: test/sql/vex/index/graph_index_memory_mode.test
# description: vex_index_info() exposes memory_mode / memory_bytes / use_pq
#              columns; memory_mode='compact' alone auto-selects pq_m via
#              ProductQuantizer::AutoSelectM. Companion to
#              graph_index_pq_compact{,_reload}.test which exercise the
#              compact runtime semantics.
# group: [vex]

require vex

statement ok
CREATE TABLE vecs (id INTEGER, vec FLOAT[4]);

statement ok
INSERT INTO vecs SELECT i,
    [(i*0.1)::FLOAT, (i*0.2)::FLOAT, (i*0.3)::FLOAT, (i*0.4)::FLOAT]::FLOAT[4]
FROM range(200) t(i);

# Default index — memory_mode reads back as 'full', no PQ, memory non-zero.
statement ok
CREATE INDEX idx_full ON vecs USING GRAPH_INDEX(vec);

query I
SELECT memory_mode FROM vex_index_info() WHERE index_name = 'idx_full';
----
full

query I
SELECT (memory_bytes > 0)::INTEGER FROM vex_index_info() WHERE index_name = 'idx_full';
----
1

query I
SELECT use_pq::INTEGER FROM vex_index_info() WHERE index_name = 'idx_full';
----
0

statement ok
DROP INDEX idx_full;

# memory_mode='compact' without explicit quantizer auto-enables PQ.
statement ok
CREATE INDEX idx_compact ON vecs USING GRAPH_INDEX(vec) WITH (memory_mode='compact');

query I
SELECT memory_mode FROM vex_index_info() WHERE index_name = 'idx_compact';
----
compact

query I
SELECT use_pq::INTEGER FROM vex_index_info() WHERE index_name = 'idx_compact';
----
1

query I
SELECT (memory_bytes > 0)::INTEGER FROM vex_index_info() WHERE index_name = 'idx_compact';
----
1

statement ok
DROP INDEX idx_compact;

# Invalid memory_mode value is rejected up front.
statement error
CREATE INDEX idx_bad ON vecs USING GRAPH_INDEX(vec) WITH (memory_mode='invalid');
----
must be 'full' or 'compact'

# memory_mode='compact' with explicit quantizer='pq' uses the user-supplied
# pq_m if any (or the auto value otherwise) — same use_pq=true result.
statement ok
CREATE INDEX idx_pq_explicit ON vecs USING GRAPH_INDEX(vec)
WITH (memory_mode='compact', quantizer='pq');

query I
SELECT use_pq::INTEGER FROM vex_index_info() WHERE index_name = 'idx_pq_explicit';
----
1

statement ok
DROP INDEX idx_pq_explicit;

statement ok
DROP TABLE vecs;
