# name: test/sql/vex/index/graph_index_metadata_dml.test
# description: Test DML on table with metadata GRAPH_INDEX (TAPD Bug 1077800)
# group: [vex]

require vex

statement ok
CREATE TABLE t (id BIGINT, v FLOAT[4]);

statement ok
INSERT INTO t SELECT i, [(i*0.1)::FLOAT, (i*0.2)::FLOAT, (i*0.3)::FLOAT, (i*0.4)::FLOAT]::FLOAT[4] FROM range(100) t(i);

statement ok
CREATE INDEX idx ON t USING GRAPH_INDEX(v, id);

# UPDATE should not crash
statement ok
UPDATE t SET id = 2 WHERE id > 50;

# DELETE should not crash
statement ok
DELETE FROM t WHERE id = 2;

# INSERT after UPDATE should work
statement ok
INSERT INTO t VALUES (999, [1.0, 2.0, 3.0, 4.0]::FLOAT[4]);

# Search should still work
query I
SELECT count(*) FROM (SELECT id FROM t ORDER BY l2_distance(v, [1.0, 2.0, 3.0, 4.0]::FLOAT[4]) LIMIT 5);
----
5

statement ok
DROP TABLE t;
