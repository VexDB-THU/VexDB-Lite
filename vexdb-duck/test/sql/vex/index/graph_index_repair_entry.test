# name: test/sql/vex/index/graph_index_repair_entry.test
# description: After deleting the row that backs the HNSW entry node, search must
#              still return correct top-k. Tests the algo's repair_entry path —
#              with multi-level enabled the entry sits on the highest-level node,
#              and dropping it leaves search starting from a stale id whose
#              neighbor list is full of other deleted ids unless we re-elect.
# group: [vex]

require vex

statement ok
SET vex_brute_force_threshold = 0;

statement ok
CREATE TABLE entry_test (id INTEGER, vec FLOAT[4]);

# 200 rows is well above the brute-force threshold so we exercise the HNSW
# path. Vectors are spread along the line vec[i] = i * (0.1, 0.2, 0.3, 0.4).
statement ok
INSERT INTO entry_test SELECT i, [(i*0.1)::FLOAT, (i*0.2)::FLOAT, (i*0.3)::FLOAT, (i*0.4)::FLOAT]::FLOAT[4] FROM range(200) t(i);

statement ok
CREATE INDEX idx_entry ON entry_test USING GRAPH_INDEX (vec);

# Sanity: closest to query [10, 20, 30, 40] is id=100 with distance 0
query I
SELECT id FROM entry_test ORDER BY l2_distance(vec, [10.0, 20.0, 30.0, 40.0]::FLOAT[4]) LIMIT 1;
----
100

# Delete a chunk that almost certainly includes the HNSW entry node. The level
# distribution gives the highest level to roughly the first dozen inserts (and
# any later insert that randomly rolls a high level), so wiping the first 50
# rows is overwhelmingly likely to cover the entry. With repair_entry wired up,
# the search should re-elect a survivor and still find id=100.
statement ok
DELETE FROM entry_test WHERE id < 50;

query I
SELECT COUNT(*) FROM entry_test;
----
150

query I
SELECT id FROM entry_test ORDER BY l2_distance(vec, [10.0, 20.0, 30.0, 40.0]::FLOAT[4]) LIMIT 1;
----
100

# Top-3 should also include id=100 (with id=99 and id=101 as next closest).
query I
SELECT COUNT(*) FROM (
    SELECT id FROM entry_test
    ORDER BY l2_distance(vec, [10.0, 20.0, 30.0, 40.0]::FLOAT[4])
    LIMIT 3
) WHERE id BETWEEN 99 AND 101;
----
3

statement ok
DROP TABLE entry_test;
