# name: test/sql/vex/index/graph_index_pq_simd_correctness.test
# description: Stricter SIMD-correctness check for the PQ kernels wired up in
#              Stage 5. Builds a d=128 PQ index and runs queries equal to
#              specific row vectors. Exact-match top-1 must return that row's
#              id, which requires compute_distance_table + distance_to_code
#              to agree numerically with the codebook the encoder wrote.
#              If SIMD path returns garbage (wrong loop bounds, wrong stride)
#              the top-1 silently shifts to a neighbor and this fires.
# group: [vex]

require vex

statement ok
SET vex_brute_force_threshold = 0;

statement ok
CREATE TABLE pq_simd (id INTEGER, vec FLOAT[128]);

# Construct 600 well-separated 128-dim vectors. Each row's vec is a per-id
# scaled basis vector — ensures every row's PQ code is unique-ish so top-1
# exact-match is deterministic regardless of codebook quantization error.
statement ok
INSERT INTO pq_simd
SELECT i, [
    sin(i*0.01)::FLOAT, cos(i*0.01)::FLOAT, sin(i*0.02)::FLOAT, cos(i*0.02)::FLOAT,
    sin(i*0.03)::FLOAT, cos(i*0.03)::FLOAT, sin(i*0.04)::FLOAT, cos(i*0.04)::FLOAT,
    sin(i*0.05)::FLOAT, cos(i*0.05)::FLOAT, sin(i*0.06)::FLOAT, cos(i*0.06)::FLOAT,
    sin(i*0.07)::FLOAT, cos(i*0.07)::FLOAT, sin(i*0.08)::FLOAT, cos(i*0.08)::FLOAT,
    sin(i*0.09)::FLOAT, cos(i*0.09)::FLOAT, sin(i*0.10)::FLOAT, cos(i*0.10)::FLOAT,
    sin(i*0.11)::FLOAT, cos(i*0.11)::FLOAT, sin(i*0.12)::FLOAT, cos(i*0.12)::FLOAT,
    sin(i*0.13)::FLOAT, cos(i*0.13)::FLOAT, sin(i*0.14)::FLOAT, cos(i*0.14)::FLOAT,
    sin(i*0.15)::FLOAT, cos(i*0.15)::FLOAT, sin(i*0.16)::FLOAT, cos(i*0.16)::FLOAT,
    sin(i*0.17)::FLOAT, cos(i*0.17)::FLOAT, sin(i*0.18)::FLOAT, cos(i*0.18)::FLOAT,
    sin(i*0.19)::FLOAT, cos(i*0.19)::FLOAT, sin(i*0.20)::FLOAT, cos(i*0.20)::FLOAT,
    sin(i*0.21)::FLOAT, cos(i*0.21)::FLOAT, sin(i*0.22)::FLOAT, cos(i*0.22)::FLOAT,
    sin(i*0.23)::FLOAT, cos(i*0.23)::FLOAT, sin(i*0.24)::FLOAT, cos(i*0.24)::FLOAT,
    sin(i*0.25)::FLOAT, cos(i*0.25)::FLOAT, sin(i*0.26)::FLOAT, cos(i*0.26)::FLOAT,
    sin(i*0.27)::FLOAT, cos(i*0.27)::FLOAT, sin(i*0.28)::FLOAT, cos(i*0.28)::FLOAT,
    sin(i*0.29)::FLOAT, cos(i*0.29)::FLOAT, sin(i*0.30)::FLOAT, cos(i*0.30)::FLOAT,
    sin(i*0.31)::FLOAT, cos(i*0.31)::FLOAT, sin(i*0.32)::FLOAT, cos(i*0.32)::FLOAT,
    sin(i*0.33)::FLOAT, cos(i*0.33)::FLOAT, sin(i*0.34)::FLOAT, cos(i*0.34)::FLOAT,
    sin(i*0.35)::FLOAT, cos(i*0.35)::FLOAT, sin(i*0.36)::FLOAT, cos(i*0.36)::FLOAT,
    sin(i*0.37)::FLOAT, cos(i*0.37)::FLOAT, sin(i*0.38)::FLOAT, cos(i*0.38)::FLOAT,
    sin(i*0.39)::FLOAT, cos(i*0.39)::FLOAT, sin(i*0.40)::FLOAT, cos(i*0.40)::FLOAT,
    sin(i*0.41)::FLOAT, cos(i*0.41)::FLOAT, sin(i*0.42)::FLOAT, cos(i*0.42)::FLOAT,
    sin(i*0.43)::FLOAT, cos(i*0.43)::FLOAT, sin(i*0.44)::FLOAT, cos(i*0.44)::FLOAT,
    sin(i*0.45)::FLOAT, cos(i*0.45)::FLOAT, sin(i*0.46)::FLOAT, cos(i*0.46)::FLOAT,
    sin(i*0.47)::FLOAT, cos(i*0.47)::FLOAT, sin(i*0.48)::FLOAT, cos(i*0.48)::FLOAT,
    sin(i*0.49)::FLOAT, cos(i*0.49)::FLOAT, sin(i*0.50)::FLOAT, cos(i*0.50)::FLOAT,
    sin(i*0.51)::FLOAT, cos(i*0.51)::FLOAT, sin(i*0.52)::FLOAT, cos(i*0.52)::FLOAT,
    sin(i*0.53)::FLOAT, cos(i*0.53)::FLOAT, sin(i*0.54)::FLOAT, cos(i*0.54)::FLOAT,
    sin(i*0.55)::FLOAT, cos(i*0.55)::FLOAT, sin(i*0.56)::FLOAT, cos(i*0.56)::FLOAT,
    sin(i*0.57)::FLOAT, cos(i*0.57)::FLOAT, sin(i*0.58)::FLOAT, cos(i*0.58)::FLOAT,
    sin(i*0.59)::FLOAT, cos(i*0.59)::FLOAT, sin(i*0.60)::FLOAT, cos(i*0.60)::FLOAT,
    sin(i*0.61)::FLOAT, cos(i*0.61)::FLOAT, sin(i*0.62)::FLOAT, cos(i*0.62)::FLOAT,
    sin(i*0.63)::FLOAT, cos(i*0.63)::FLOAT, sin(i*0.64)::FLOAT, cos(i*0.64)::FLOAT
]::FLOAT[128]
FROM range(1, 601) t(i);

statement ok
CREATE INDEX idx_pq_simd ON pq_simd USING GRAPH_INDEX (vec) WITH (quantizer = 'pq', pq_m = 16);

statement ok
SET vex_pq_search_mode = 'pq_only';

# Exact-match query: query vector equals row id=200's stored vector. PQ
# approximation of distance(row_200, row_200) is sum of per-subq quantization
# errors of row_200's own code — strictly smaller than the same sum for any
# OTHER row's code under the same query (each other row's code drifted in a
# different direction). Top-1 must be 200.
query I
SELECT id FROM pq_simd
ORDER BY l2_distance(vec, (SELECT vec FROM pq_simd WHERE id = 200))
LIMIT 1;
----
200

# Same check with id=450 — guards against accidental dependency on a single
# row position (e.g., bug that always returns the first encoded row).
query I
SELECT id FROM pq_simd
ORDER BY l2_distance(vec, (SELECT vec FROM pq_simd WHERE id = 450))
LIMIT 1;
----
450

# Top-3 should include the exact-match id. Stricter than top-1 — catches
# the case where the SIMD path puts the exact match at rank 2 or 3 due to
# a tied/incorrect distance-table entry.
query I
SELECT COUNT(*) FROM (
    SELECT id FROM pq_simd
    ORDER BY l2_distance(vec, (SELECT vec FROM pq_simd WHERE id = 350))
    LIMIT 3
) WHERE id = 350;
----
1

statement ok
RESET vex_pq_search_mode;

statement ok
DROP TABLE pq_simd;
