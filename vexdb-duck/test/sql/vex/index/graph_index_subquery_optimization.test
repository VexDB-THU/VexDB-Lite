# name: test/sql/vex/index/graph_index_subquery_optimization.test
# description: Test that subqueries as query vectors trigger index scan optimization
# group: [vex]

require vex

# ============================================================
# Setup: main vector table with deterministic data (100 rows)
# ============================================================
statement ok
CREATE TABLE t (id INTEGER, v FLOAT[4]);

statement ok
INSERT INTO t SELECT i, [0.01*i, 0.02*i, 0.03*i, 0.04*i]::FLOAT[4] FROM range(1, 101) tbl(i);

# ============================================================
# Setup: L2 index (default metric)
# ============================================================
statement ok
CREATE INDEX idx_l2 ON t USING GRAPH_INDEX (v);

# ============================================================
# Setup: query table for cross-table subquery tests
# ============================================================
statement ok
CREATE TABLE queries (qid INTEGER, qvec FLOAT[4]);

statement ok
INSERT INTO queries VALUES
  (1, [0.5, 1.0, 1.5, 2.0]::FLOAT[4]),
  (2, [0.01, 0.02, 0.03, 0.04]::FLOAT[4]);

# ============================================================
# Test 1: CTE as query vector - EXPLAIN should show extension index scan
# ============================================================
query II
EXPLAIN WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY l2_distance(v, (SELECT vec FROM tmp)) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 2: CTE as query vector - result correctness
# Rows 48 and 52 are equidistant (same L2 distance), so use
# a sorted comparison that ignores tie-breaking order.
# ============================================================
query I sort
WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY l2_distance(v, (SELECT vec FROM tmp)) LIMIT 5;
----
48
49
50
51
52

# ============================================================
# Test 3: Cross-table subquery - EXPLAIN should show extension index scan
# ============================================================
query II
EXPLAIN SELECT id FROM t ORDER BY l2_distance(v, (SELECT qvec FROM queries WHERE qid = 1)) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 4: Cross-table subquery - result correctness
# ============================================================
query I sort
SELECT id FROM t ORDER BY l2_distance(v, (SELECT qvec FROM queries WHERE qid = 1)) LIMIT 5;
----
48
49
50
51
52

# ============================================================
# Test 5: Cross-table subquery with qid=2 (close to row 1)
# ============================================================
query I
SELECT id FROM t ORDER BY l2_distance(v, (SELECT qvec FROM queries WHERE qid = 2)) LIMIT 3;
----
1
2
3

# ============================================================
# Test 6: <-> operator with subquery - EXPLAIN
# ============================================================
query II
EXPLAIN WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT id FROM t ORDER BY v <-> (SELECT v FROM q) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 7: <-> operator with subquery - result correctness
# ============================================================
query I sort
WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT id FROM t ORDER BY v <-> (SELECT v FROM q) LIMIT 5;
----
48
49
50
51
52

# ============================================================
# Test 8: Subquery with inline CAST - EXPLAIN
# ============================================================
query II
EXPLAIN SELECT id FROM t ORDER BY l2_distance(v, (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4])) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 9: Subquery with inline CAST - result correctness
# ============================================================
query I sort
SELECT id FROM t ORDER BY l2_distance(v, (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4])) LIMIT 5;
----
48
49
50
51
52

# ============================================================
# Test 10: Constant vector baseline (should still work as before)
# ============================================================
query II
EXPLAIN SELECT id FROM t ORDER BY l2_distance(v, [0.5, 1.0, 1.5, 2.0]::FLOAT[4]) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

query I sort
SELECT id FROM t ORDER BY l2_distance(v, [0.5, 1.0, 1.5, 2.0]::FLOAT[4]) LIMIT 5;
----
48
49
50
51
52

# ============================================================
# Test 11: Subquery result matches constant vector result (correctness)
# Verify that index-based subquery search returns same results as
# constant vector index search
# ============================================================
query I
(WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY l2_distance(v, (SELECT vec FROM tmp)) LIMIT 5)
EXCEPT
(SELECT id FROM t ORDER BY l2_distance(v, [0.5, 1.0, 1.5, 2.0]::FLOAT[4]) LIMIT 5);
----

# ============================================================
# Cleanup L2 index, setup Cosine index
# ============================================================
statement ok
DROP INDEX idx_l2;

statement ok
CREATE INDEX idx_cos ON t USING GRAPH_INDEX (v) WITH (metric='cosine');

# ============================================================
# Test 12: Cosine - CTE subquery EXPLAIN
# ============================================================
query II
EXPLAIN WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY cosine_distance(v, (SELECT vec FROM tmp)) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 13: Cosine - CTE subquery result count
# All vectors are collinear (proportional to [1,2,3,4]), so cosine
# distances are all ~0. Any 5 rows are valid top-5 results.
# ============================================================
query I
WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT count(*) FROM (SELECT id FROM t ORDER BY cosine_distance(v, (SELECT vec FROM tmp)) LIMIT 5);
----
5

# ============================================================
# Test 14: <=> operator with subquery - EXPLAIN
# ============================================================
query II
EXPLAIN WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT id FROM t ORDER BY v <=> (SELECT v FROM q) LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 15: <=> operator with subquery - result count
# ============================================================
query I
WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT count(*) FROM (SELECT id FROM t ORDER BY v <=> (SELECT v FROM q) LIMIT 5);
----
5

# ============================================================
# Test 16: Cosine - cross-table subquery result count
# ============================================================
query I
SELECT count(*) FROM (SELECT id FROM t ORDER BY cosine_distance(v, (SELECT qvec FROM queries WHERE qid = 1)) LIMIT 5);
----
5

# ============================================================
# Cleanup Cosine index, setup IP index
# ============================================================
statement ok
DROP INDEX idx_cos;

statement ok
CREATE INDEX idx_ip ON t USING GRAPH_INDEX (v) WITH (metric='ip');

# ============================================================
# Test 17: Inner Product - CTE subquery EXPLAIN (DESC order)
# ============================================================
query II
EXPLAIN WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY inner_product(v, (SELECT vec FROM tmp)) DESC LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 18: Inner Product - CTE subquery result (DESC)
# ============================================================
query I
WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY inner_product(v, (SELECT vec FROM tmp)) DESC LIMIT 5;
----
100
99
98
97
96

# ============================================================
# Test 19: <~> with DESC should NOT trigger optimizer
# (<~> = negative inner product, requires ASC for nearest neighbors)
# ============================================================
query II
EXPLAIN WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT id FROM t ORDER BY v <~> (SELECT v FROM q) DESC LIMIT 5;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 20: <~> with ASC subquery - should trigger optimizer (uses cosine index)
# ============================================================
statement ok
CREATE INDEX idx_cos ON t USING GRAPH_INDEX (v) WITH (metric='cosine');

query II
EXPLAIN WITH q AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS v)
SELECT id FROM t ORDER BY v <~> (SELECT v FROM q) ASC LIMIT 5;
----
physical_plan	<REGEX>:.*VEX_INDEX_SCAN.*

# ============================================================
# Test 21: Inner Product - cross-table subquery
# ============================================================
query I
SELECT id FROM t ORDER BY inner_product(v, (SELECT qvec FROM queries WHERE qid = 1)) DESC LIMIT 5;
----
100
99
98
97
96

# ============================================================
# Test 22: IP with ASC should NOT trigger optimizer (wrong order)
# ============================================================
query II
EXPLAIN WITH tmp AS (SELECT [0.5, 1.0, 1.5, 2.0]::FLOAT[4] AS vec)
SELECT id FROM t ORDER BY inner_product(v, (SELECT vec FROM tmp)) ASC LIMIT 5;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP INDEX idx_ip;

statement ok
DROP TABLE queries;

statement ok
DROP TABLE t;
