# name: test/sql/vex/functions/simd_arch.test
# description: vex_simd_arch() exposes the runtime CPU arch picked by
#              ann_helper::get_best_arch(). Used to verify that
#              quantizer/product_quantizer.cpp's set_*_func actually wired
#              into a SIMD kernel rather than the GENERAL fallback.
# group: [vex]

require vex

# Returns a non-empty string from a known set.
query I
SELECT vex_simd_arch() IN ('SSE', 'AVX', 'AVX512', 'NEONV8', 'SVEV8', 'SVE2V8', 'GENERAL');
----
true

# Hardware regression alarm: on x86_64 / aarch64 hosts get_best_arch()
# should never fall back to GENERAL — that would mean the SIMD primitives
# are not being dispatched and PQ runs at scalar speed. Skip this assertion
# when running in CI emulators or unusual environments by checking platform
# via a pragma is overkill; for now the assertion is hard. If it fires,
# investigate architecture detection in src/distance/core/architecture.cpp
# before disabling.
query I
SELECT vex_simd_arch() != 'GENERAL';
----
true
