# name: test/sql/vex/index/graph_index_cpp_api.test_slow
# description: C++ API level tests - transactions, rollback, concurrent connections
# group: [vex]

require vex

# ============================================================
# Test 1: Transaction rollback - INSERT should be undone
# ============================================================
statement ok
CREATE TABLE t_rollback (id INTEGER, vec FLOAT[4]);

statement ok
CREATE INDEX idx_rb ON t_rollback USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t_rollback VALUES (1, [1.0, 0.0, 0.0, 0.0]::FLOAT[4]);

statement ok
INSERT INTO t_rollback VALUES (2, [0.0, 1.0, 0.0, 0.0]::FLOAT[4]);

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO t_rollback VALUES (3, [0.0, 0.0, 1.0, 0.0]::FLOAT[4]);

statement ok
INSERT INTO t_rollback VALUES (4, [0.0, 0.0, 0.0, 1.0]::FLOAT[4]);

statement ok
ROLLBACK;

# After rollback, should only have 2 rows
query I
SELECT count(*) FROM t_rollback;
----
2

# Search should still work (no crash from rolled-back nodes)
query I
SELECT count(*) FROM (SELECT id FROM t_rollback ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 2);
----
2

# ============================================================
# Test 2: Transaction rollback - DELETE should be undone
# ============================================================
statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM t_rollback WHERE id = 1;

# Within transaction: only 1 row visible
query I
SELECT count(*) FROM t_rollback;
----
1

statement ok
ROLLBACK;

# After rollback: both rows visible again
query I
SELECT count(*) FROM t_rollback;
----
2

query I
SELECT count(*) FROM (SELECT id FROM t_rollback ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 2);
----
2

# ============================================================
# Test 3: Commit then search
# ============================================================
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO t_rollback VALUES (5, [0.5, 0.5, 0.5, 0.5]::FLOAT[4]);

statement ok
COMMIT;

query I
SELECT count(*) FROM t_rollback;
----
3

query I
SELECT count(*) FROM (SELECT id FROM t_rollback ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5]::FLOAT[4]) LIMIT 3);
----
3

# ============================================================
# Test 4: Multiple sequential transactions
# ============================================================
loop i 10 30

statement ok
INSERT INTO t_rollback VALUES (${i}, [${i}.0, 0.0, 0.0, 0.0]::FLOAT[4]);

endloop

query I
SELECT count(*) FROM t_rollback;
----
23

# Delete some in a loop
loop i 10 20

statement ok
DELETE FROM t_rollback WHERE id = ${i};

endloop

query I
SELECT count(*) FROM t_rollback;
----
13

# ANN search after loop insert+delete
query I
SELECT count(*) FROM (SELECT id FROM t_rollback ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 10);
----
10

# ============================================================
# Test 5: Interleaved insert and search (simulate concurrent workload)
# ============================================================
statement ok
DROP TABLE t_rollback;

statement ok
CREATE TABLE t_interleave (id INTEGER, vec FLOAT[4]);

statement ok
CREATE INDEX idx_il ON t_interleave USING GRAPH_INDEX (vec);

# Insert-search-insert-search pattern (20 rounds)
loop i 1 21

statement ok
INSERT INTO t_interleave VALUES (${i}, [${i}.0, 0.0, 0.0, 0.0]::FLOAT[4]);

statement ok
SELECT id FROM t_interleave ORDER BY l2_distance(vec, [${i}.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 5;

endloop

query I
SELECT count(*) FROM t_interleave;
----
20

# ============================================================
# Test 6: Insert-delete-search rapid cycle (50 rounds)
# ============================================================
statement ok
DROP TABLE t_interleave;

statement ok
CREATE TABLE t_rapid (id INTEGER, vec FLOAT[4]);

statement ok
CREATE INDEX idx_rapid ON t_rapid USING GRAPH_INDEX (vec);

# Bulk insert first
statement ok
INSERT INTO t_rapid SELECT i, list_value(sin(i)::FLOAT, cos(i)::FLOAT, sin(i*2)::FLOAT, cos(i*2)::FLOAT)::FLOAT[4]
FROM range(1, 201) t(i);

# Rapid delete-search cycles
loop i 1 51

statement ok
DELETE FROM t_rapid WHERE id = ${i};

statement ok
SELECT count(*) FROM (SELECT id FROM t_rapid ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 5);

endloop

# Should have 150 rows left
query I
SELECT count(*) FROM t_rapid;
----
150

query I
SELECT count(*) FROM (SELECT id FROM t_rapid ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 20);
----
20

# ============================================================
# Test 7: Large transaction with many inserts then commit
# ============================================================
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO t_rapid SELECT i, list_value(sin(i)::FLOAT, cos(i)::FLOAT, sin(i*2)::FLOAT, cos(i*2)::FLOAT)::FLOAT[4]
FROM range(201, 501) t(i);

statement ok
COMMIT;

query I
SELECT count(*) FROM t_rapid;
----
450

query I
SELECT count(*) FROM (SELECT id FROM t_rapid ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 50);
----
50

# ============================================================
# Test 8: Large transaction with many inserts then rollback
# ============================================================
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO t_rapid SELECT i, list_value(sin(i)::FLOAT, cos(i)::FLOAT, sin(i*2)::FLOAT, cos(i*2)::FLOAT)::FLOAT[4]
FROM range(501, 1001) t(i);

statement ok
ROLLBACK;

# Count should be unchanged
query I
SELECT count(*) FROM t_rapid;
----
450

# Search should not crash
query I
SELECT count(*) FROM (SELECT id FROM t_rapid ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 20);
----
20

# ============================================================
# Test 9: Delete all in transaction, rollback, verify recovery
# ============================================================
statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM t_rapid;

query I
SELECT count(*) FROM t_rapid;
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM t_rapid;
----
450

# ============================================================
# Test 10: UPDATE vectors (delete + insert internally)
# ============================================================
statement ok
UPDATE t_rapid SET vec = [99.0, 99.0, 99.0, 99.0]::FLOAT[4] WHERE id = 51;

query I
SELECT count(*) FROM t_rapid;
----
450

query I
SELECT count(*) FROM (SELECT id FROM t_rapid ORDER BY l2_distance(vec, [99.0, 99.0, 99.0, 99.0]::FLOAT[4]) LIMIT 1);
----
1

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_rapid;
