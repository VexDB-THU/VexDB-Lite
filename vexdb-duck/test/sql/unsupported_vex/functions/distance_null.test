# name: test/sql/vex/functions/distance_null.test
# description: Test distance operators handle NULL values gracefully
# group: [vex]

require vex

# ============================================================
# NULL vector should return NULL, not error
# ============================================================

query I
SELECT NULL <-> [1.0, 2.0, 3.0]::FLOAT[3];
----
NULL

query I
SELECT [1.0, 2.0, 3.0]::FLOAT[3] <-> NULL;
----
NULL

query I
SELECT NULL <=> [1.0, 2.0, 3.0]::FLOAT[3];
----
NULL

query I
SELECT NULL <~> [1.0, 2.0, 3.0]::FLOAT[3];
----
NULL

# ============================================================
# ORDER BY with NULL values in column should not error
# ============================================================

statement ok
CREATE TABLE t_null (id INTEGER, v FLOAT[3]);

statement ok
INSERT INTO t_null VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]);

statement ok
INSERT INTO t_null VALUES (2, NULL);

statement ok
INSERT INTO t_null VALUES (3, [0.0, 1.0, 0.0]::FLOAT[3]);

# ORDER BY with <-> should skip NULL rows, not error
query I
SELECT id FROM t_null ORDER BY v <-> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 2;
----
1
3

# ORDER BY with <=> should skip NULL rows
query I
SELECT id FROM t_null ORDER BY v <=> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 2;
----
1
3

# ORDER BY with l2_distance should skip NULL rows
query I
SELECT id FROM t_null ORDER BY l2_distance(v, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
1
3

# ============================================================
# With index — NULL rows should be skipped
# ============================================================

statement ok
CREATE TABLE t_null_idx (id INTEGER, v FLOAT[3]);

statement ok
INSERT INTO t_null_idx VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]);

statement ok
INSERT INTO t_null_idx VALUES (2, NULL);

statement ok
INSERT INTO t_null_idx VALUES (3, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
INSERT INTO t_null_idx VALUES (4, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_null ON t_null_idx USING GRAPH_INDEX (v);

query I
SELECT id FROM t_null_idx ORDER BY l2_distance(v, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
1
3
4

# Clean up
statement ok
DROP TABLE t_null;

statement ok
DROP TABLE t_null_idx;
