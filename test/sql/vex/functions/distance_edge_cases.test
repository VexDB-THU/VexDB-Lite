# name: test/sql/vex/functions/distance_edge_cases.test
# description: Test distance function edge cases (zero vectors, extreme values, single dim)
# group: [vex]

require vex

# ============================================================
# Test 1: Zero vector — l2_distance([0,0,0], [1,0,0]) = 1.0
# ============================================================
query R
SELECT l2_distance([0.0, 0.0, 0.0]::FLOATVECTOR(3), [1.0, 0.0, 0.0]::FLOATVECTOR(3));
----
1.0

query R
SELECT l2_distance([0.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 0.0, 0.0]::FLOATVECTOR(3));
----
0.0

# ============================================================
# Test 2: Same vector — distance to self = 0
# ============================================================
query R
SELECT l2_distance([3.14, 2.71, 1.41]::FLOATVECTOR(3), [3.14, 2.71, 1.41]::FLOATVECTOR(3));
----
0.0

query R
SELECT cosine_distance([3.14, 2.71, 1.41]::FLOATVECTOR(3), [3.14, 2.71, 1.41]::FLOATVECTOR(3));
----
0.0

# ============================================================
# Test 3: Very large values
# ============================================================
query I
SELECT l2_distance([1e30, 0.0]::FLOATVECTOR(2), [0.0, 0.0]::FLOATVECTOR(2)) > 0;
----
true

query I
SELECT l2_distance([1e10, 1e10]::FLOATVECTOR(2), [1e10, 1e10]::FLOATVECTOR(2)) = 0;
----
true

# ============================================================
# Test 4: Very small values (near float min positive)
# ============================================================
query I
SELECT l2_distance([1e-30, 0.0]::FLOATVECTOR(2), [0.0, 0.0]::FLOATVECTOR(2)) >= 0;
----
true

query I
SELECT l2_distance([1e-10, 1e-10]::FLOATVECTOR(2), [2e-10, 2e-10]::FLOATVECTOR(2)) > 0;
----
true

# ============================================================
# Test 5: Negative values — all functions should handle them
# ============================================================
query R
SELECT l2_distance([-1.0, -2.0, -3.0]::FLOATVECTOR(3), [1.0, 2.0, 3.0]::FLOATVECTOR(3));
----
7.483314773547883

query I
SELECT l2_distance([-1.0, 0.0]::FLOATVECTOR(2), [1.0, 0.0]::FLOATVECTOR(2)) = 2.0;
----
true

# Cosine distance with negative vectors
# [-1,0] and [1,0] are opposite directions, cosine distance = 2.0
query R
SELECT cosine_distance([-1.0, 0.0]::FLOATVECTOR(2), [1.0, 0.0]::FLOATVECTOR(2));
----
2.0

# Inner product with negative values
query R
SELECT inner_product([-1.0, -2.0]::FLOATVECTOR(2), [3.0, 4.0]::FLOATVECTOR(2));
----
-11.0

# ============================================================
# Test 6: Single dimension — l2_distance([5.0], [3.0])
# ============================================================
query R
SELECT l2_distance([5.0]::FLOATVECTOR(1), [3.0]::FLOATVECTOR(1));
----
2.0

query R
SELECT l2_distance([0.0]::FLOATVECTOR(1), [0.0]::FLOATVECTOR(1));
----
0.0

query R
SELECT inner_product([5.0]::FLOATVECTOR(1), [3.0]::FLOATVECTOR(1));
----
15.0

# ============================================================
# Test 7: cosine_distance of zero vector returns 1.0 (degenerate case fallback)
# ============================================================
query R
SELECT cosine_distance([0.0, 0.0, 0.0]::FLOATVECTOR(3), [1.0, 0.0, 0.0]::FLOATVECTOR(3));
----
1.0

query R
SELECT cosine_distance([0.0, 0.0]::FLOATVECTOR(2), [0.0, 0.0]::FLOATVECTOR(2));
----
1.0

# ============================================================
# Test 8: Inner product with orthogonal vectors = 0
# ============================================================
query R
SELECT inner_product([1.0, 0.0]::FLOATVECTOR(2), [0.0, 1.0]::FLOATVECTOR(2));
----
0.0

query R
SELECT inner_product([1.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 1.0, 0.0]::FLOATVECTOR(3));
----
0.0

query R
SELECT inner_product([1.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 0.0, 1.0]::FLOATVECTOR(3));
----
0.0

# ============================================================
# Test 9: Mixed positive and negative with known results
# ============================================================
# [1, -1] dot [1, 1] = 1 + (-1) = 0
query R
SELECT inner_product([1.0, -1.0]::FLOATVECTOR(2), [1.0, 1.0]::FLOATVECTOR(2));
----
0.0

# l2_distance([1,0], [-1,0]) = 2.0
query R
SELECT l2_distance([1.0, 0.0]::FLOATVECTOR(2), [-1.0, 0.0]::FLOATVECTOR(2));
----
2.0

# ============================================================
# Test 10: Distance functions in table context
# ============================================================
statement ok
CREATE TABLE edge_vecs (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO edge_vecs VALUES
  (1, [0.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [-1.0, -1.0, -1.0]::FLOATVECTOR(3)),
  (3, [100.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (4, [0.001, 0.001, 0.001]::FLOATVECTOR(3));

# Nearest to origin should be id=1 (zero vector, distance=0)
query I
SELECT id FROM edge_vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

# Nearest to [-1,-1,-1] should be id=2
query I
SELECT id FROM edge_vecs ORDER BY l2_distance(vec, [-1.0, -1.0, -1.0]::FLOATVECTOR(3)) LIMIT 1;
----
2

# Farthest from origin (by L2) should be id=3
query I
SELECT id FROM edge_vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) DESC LIMIT 1;
----
3

statement ok
DROP TABLE edge_vecs;
