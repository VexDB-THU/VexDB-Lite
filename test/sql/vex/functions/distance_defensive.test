# name: test/sql/vex/functions/distance_defensive.test
# description: Defensive tests for distance functions - uncast literals, type coercion, error handling
# group: [vex]

require vex

statement ok
CREATE TABLE t_def(c1 INTEGER, c2 FLOATVECTOR(3));

statement ok
INSERT INTO t_def VALUES
  (1, [1.0, 2.0, 3.0]),
  (2, [4.0, 5.0, 6.0]),
  (3, [0.1, 0.2, 0.3]);

# ============================================================
# Uncast literal arrays (was: "Vector dimension mismatch: 3 vs 0")
# ============================================================

# l2_distance with uncast float literal
query R
SELECT l2_distance(c2, [0.0, 0.0, 0.0]) FROM t_def WHERE c1 = 1;
----
3.7416573867739413

# cosine_distance with uncast float literal
query I
SELECT cosine_distance(c2, [1.0, 0.0, 0.0]) > 0 FROM t_def WHERE c1 = 1;
----
true

# inner_product with uncast float literal
query R
SELECT inner_product(c2, [1.0, 0.0, 0.0]) FROM t_def WHERE c1 = 1;
----
1.0

# ============================================================
# Integer literals (implicit cast from int to float)
# ============================================================

query R
SELECT l2_distance(c2, [0, 0, 0]) FROM t_def WHERE c1 = 1;
----
3.7416573867739413

query R
SELECT l2_distance(c2, [1, 2, 3]) FROM t_def WHERE c1 = 1;
----
0.0

query R
SELECT inner_product(c2, [1, 0, 0]) FROM t_def WHERE c1 = 1;
----
1.0

# ============================================================
# Mixed int/float literals
# ============================================================

query R
SELECT l2_distance(c2, [1, 2.0, 3]) FROM t_def WHERE c1 = 1;
----
0.0

# ============================================================
# ORDER BY + LIMIT with uncast literals (optimizer path)
# ============================================================

query I
SELECT c1 FROM t_def ORDER BY l2_distance(c2, [0.0, 0.0, 0.0]) LIMIT 1;
----
3

query I
SELECT c1 FROM t_def ORDER BY l2_distance(c2, [1, 2, 3]) LIMIT 1;
----
1

query I
SELECT c1 FROM t_def ORDER BY cosine_distance(c2, [1.0, 0.0, 0.0]) LIMIT 1;
----
2

# ============================================================
# Reversed argument order (literal first, column second)
# ============================================================

query R
SELECT l2_distance([0.0, 0.0, 0.0], c2) FROM t_def WHERE c1 = 1;
----
3.7416573867739413

query R
SELECT cosine_distance([1.0, 0.0, 0.0], c2) FROM t_def WHERE c1 = 1;
----
0.732738733291626

# ============================================================
# Dimension mismatch should produce clear error
# ============================================================

statement error
SELECT l2_distance(c2, [0.0, 0.0]) FROM t_def WHERE c1 = 1;
----
Cannot cast list with length 2 to array with length 3

statement error
SELECT cosine_distance(c2, [0.0, 0.0, 0.0, 0.0]) FROM t_def WHERE c1 = 1;
----
Cannot cast list with length 4 to array with length 3

# ============================================================
# NULL handling
# ============================================================

query R
SELECT l2_distance(c2, NULL) FROM t_def WHERE c1 = 1;
----
NULL

query R
SELECT l2_distance(NULL, c2) FROM t_def WHERE c1 = 1;
----
NULL

query R
SELECT cosine_distance(c2, NULL) FROM t_def WHERE c1 = 1;
----
NULL

# ============================================================
# With index: uncast literals should work with graph index scan
# ============================================================

statement ok
CREATE INDEX idx_graph ON t_def USING GRAPH_INDEX (c2);

query I
SELECT c1 FROM t_def ORDER BY l2_distance(c2, [0.0, 0.0, 0.0]) LIMIT 1;
----
3

query I
SELECT c1 FROM t_def ORDER BY l2_distance(c2, [1, 2, 3]) LIMIT 1;
----
1

query I
SELECT c1 FROM t_def ORDER BY cosine_distance(c2, [1.0, 0.0, 0.0]) LIMIT 1;
----
2

statement ok
DROP INDEX idx_graph;

statement ok
DROP TABLE t_def;
