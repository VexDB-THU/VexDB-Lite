# name: test/sql/vex/functions/distance_ip.test
# description: Test inner_product function
# group: [vex]

require vex

# Basic inner product
query R
SELECT inner_product([1.0, 2.0, 3.0]::FLOATVECTOR(3), [4.0, 5.0, 6.0]::FLOATVECTOR(3));
----
32.0

# Inner product with zero vector
query R
SELECT inner_product([1.0, 2.0]::FLOATVECTOR(2), [0.0, 0.0]::FLOATVECTOR(2));
----
0.0

# Inner product with self
query R
SELECT inner_product([3.0, 4.0]::FLOATVECTOR(2), [3.0, 4.0]::FLOATVECTOR(2));
----
25.0

# NULL input returns NULL
query R
SELECT inner_product(NULL::FLOATVECTOR(2), [1.0, 2.0]::FLOATVECTOR(2));
----
NULL
