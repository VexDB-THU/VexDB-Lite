# name: test/sql/vex/functions/vector_ops.test
# description: Test vector utility functions
# group: [vex]

require vex

# vector_dims
query I
SELECT vector_dims([1.0, 2.0, 3.0]::FLOAT[3]);
----
3

query I
SELECT vector_dims([1.0]::FLOAT[1]);
----
1

# vector_norm (L2 norm)
query R
SELECT vector_norm([3.0, 4.0]::FLOAT[2]);
----
5.0

query R
SELECT vector_norm([0.0, 0.0, 0.0]::FLOAT[3]);
----
0.0

query R
SELECT vector_norm([1.0]::FLOAT[1]);
----
1.0

# l2_normalize
query I
SELECT vector_dims(l2_normalize([3.0, 4.0]::FLOAT[2]));
----
2

# vector_add
query I
SELECT vector_dims(vector_add([1.0, 2.0]::FLOAT[2], [3.0, 4.0]::FLOAT[2]));
----
2

# vector_sub
query I
SELECT vector_dims(vector_sub([3.0, 4.0]::FLOAT[2], [1.0, 1.0]::FLOAT[2]));
----
2

# NULL handling
query R
SELECT vector_norm(NULL::FLOAT[3]);
----
NULL

query I
SELECT vector_dims(NULL::FLOAT[3]);
----
NULL
