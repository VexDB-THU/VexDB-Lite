# name: test/sql/vex/functions/distance_l2.test
# description: Test l2_distance function
# group: [vex]

require vex

# Basic L2 distance
query R
SELECT l2_distance([1.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 1.0, 0.0]::FLOATVECTOR(3));
----
1.4142135623730951

# Distance to self is 0
query R
SELECT l2_distance([1.0, 2.0, 3.0]::FLOATVECTOR(3), [1.0, 2.0, 3.0]::FLOATVECTOR(3));
----
0.0

# Simple distance
query R
SELECT l2_distance([0.0, 0.0]::FLOATVECTOR(2), [3.0, 4.0]::FLOATVECTOR(2));
----
5.0

# Table scan with ordering
statement ok
CREATE TABLE items (id INT, v FLOATVECTOR(3));

statement ok
INSERT INTO items VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3)),
  (4, [1.0, 1.0, 0.0]::FLOATVECTOR(3));

query I
SELECT id FROM items ORDER BY l2_distance(v, [1.0, 0.0, 0.0]::FLOATVECTOR(3)), id LIMIT 3;
----
1
4
2

# NULL input returns NULL
query R
SELECT l2_distance(NULL::FLOATVECTOR(3), [1.0, 2.0, 3.0]::FLOATVECTOR(3));
----
NULL
