# name: test/sql/vex/index/hybrid_index_allocator_storage.test_slow
# description: HybridIndex allocator-based serialization - restart+delete, restart+insert+restart, empty table, multi-checkpoint cycles, many partitions
# group: [vex]

require vex

# ============================================================
# Test 1: Restart then DELETE (row_id_map restored from storage)
# ============================================================
load __TEST_DIR__/hybrid_alloc_test1.db

statement ok
CREATE TABLE t1 (id INTEGER PRIMARY KEY, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx1 ON t1 USING HYBRID_INDEX (vec, cat);

statement ok
INSERT INTO t1 SELECT i, 'a', list_value(sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT, sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(1, 51) t(i);

statement ok
INSERT INTO t1 SELECT i, 'b', list_value(cos(i*0.1)::FLOAT, sin(i*0.2)::FLOAT, cos(i*0.3)::FLOAT, sin(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(51, 101) t(i);

query I
SELECT count(*) FROM t1;
----
100

statement ok
CHECKPOINT;

restart

# Delete after restart — this exercises the deserialized row_id_map and row_partition_map_
statement ok
DELETE FROM t1 WHERE cat = 'a' AND id <= 10;

query I
SELECT count(*) FROM t1 WHERE cat = 'a';
----
40

# Verify search still works after delete-post-restart
query I
SELECT count(*) FROM (SELECT id FROM t1 WHERE cat = 'a' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Partition b untouched
query I
SELECT count(*) FROM t1 WHERE cat = 'b';
----
50

# Cross-partition delete after restart
statement ok
DELETE FROM t1 WHERE id % 3 = 0;

query I
SELECT count(*) FROM (SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Checkpoint the post-restart deletes, restart again
statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM (SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: Restart then INSERT then restart again
#   Verify allocator incremental writes work on deserialized allocators
# ============================================================
load __TEST_DIR__/hybrid_alloc_test2.db

statement ok
CREATE TABLE t2 (id INTEGER PRIMARY KEY, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx2 ON t2 USING HYBRID_INDEX (vec, cat);

statement ok
INSERT INTO t2 SELECT i, 'x', list_value(sin(i)::FLOAT, cos(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(1, 51) t(i);

statement ok
CHECKPOINT;

restart

# Insert into existing partition after restart
statement ok
INSERT INTO t2 SELECT i, 'x', list_value(sin(i)::FLOAT, cos(i)::FLOAT, 0.5, 0.5)::FLOATVECTOR(4)
FROM range(51, 101) t(i);

# Insert into NEW partition after restart
statement ok
INSERT INTO t2 SELECT i, 'y', list_value(cos(i)::FLOAT, sin(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(101, 151) t(i);

query I
SELECT count(*) FROM t2;
----
150

query I
SELECT count(*) FROM t2 WHERE cat = 'x';
----
100

query I
SELECT count(*) FROM t2 WHERE cat = 'y';
----
50

# Verify search works with mixed old+new data
query I
SELECT count(*) FROM (SELECT id FROM t2 WHERE cat = 'x' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

query I
SELECT count(*) FROM (SELECT id FROM t2 WHERE cat = 'y' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Checkpoint with new data, restart again
statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM t2;
----
150

query I
SELECT count(*) FROM (SELECT id FROM t2 WHERE cat = 'x' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

query I
SELECT count(*) FROM (SELECT id FROM t2 WHERE cat = 'y' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: Empty table with HYBRID_INDEX — checkpoint + restart
# ============================================================
load __TEST_DIR__/hybrid_alloc_test3.db

statement ok
CREATE TABLE t3 (id INTEGER, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx3 ON t3 USING HYBRID_INDEX (vec, cat);

statement ok
CHECKPOINT;

restart

# Index should exist but be empty
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx3';
----
1

query I
SELECT count(*) FROM t3;
----
0

# Insert after restart on empty index
statement ok
INSERT INTO t3 VALUES (1, 'a', [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)),
                      (2, 'a', [0.9, 0.1, 0.0, 0.0]::FLOATVECTOR(4)),
                      (3, 'b', [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4));

query I
SELECT count(*) FROM (SELECT id FROM t3 WHERE cat = 'a' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 2);
----
2

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM t3;
----
3

# Filtered search on each partition after restart
query I
SELECT count(*) FROM (SELECT id FROM t3 WHERE cat = 'a' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 2);
----
2

query I
SELECT count(*) FROM (SELECT id FROM t3 WHERE cat = 'b' ORDER BY l2_distance(vec, [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 1);
----
1

statement ok
DROP TABLE t3;

# ============================================================
# Test 4: Multiple checkpoint-restart cycles (idempotency)
# ============================================================
load __TEST_DIR__/hybrid_alloc_test4.db

statement ok
CREATE TABLE t4 (id INTEGER PRIMARY KEY, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx4 ON t4 USING HYBRID_INDEX (vec, cat);

statement ok
INSERT INTO t4 SELECT i, 'p' || (i % 3)::VARCHAR, list_value(sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT, sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(1, 61) t(i);

# Cycle 1
statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM t4;
----
60

query I
SELECT count(*) FROM (SELECT id FROM t4 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Cycle 2: modify then checkpoint
statement ok
DELETE FROM t4 WHERE id % 4 = 0;

statement ok
INSERT INTO t4 SELECT i, 'p_new', list_value(0.0, 0.0, sin(i)::FLOAT, cos(i)::FLOAT)::FLOATVECTOR(4)
FROM range(61, 76) t(i);

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM (SELECT id FROM t4 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Cycle 3: checkpoint without changes (no-op serialize/deserialize)
statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM (SELECT id FROM t4 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Cycle 4: delete all from one partition, checkpoint, restart, insert
statement ok
DELETE FROM t4 WHERE cat = 'p0';

statement ok
CHECKPOINT;

restart

statement ok
INSERT INTO t4 SELECT i, 'p0', list_value(sin(i)::FLOAT, cos(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(100, 120) t(i);

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM t4 WHERE cat = 'p0';
----
20

query I
SELECT count(*) FROM (SELECT id FROM t4 WHERE cat = 'p0' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

statement ok
DROP TABLE t4;

# ============================================================
# Test 5: Many partitions (50+) — stress allocator_infos array
# ============================================================
load __TEST_DIR__/hybrid_alloc_test5.db

statement ok
CREATE TABLE t5 (id INTEGER, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx5 ON t5 USING HYBRID_INDEX (vec, cat);

# Insert 500 rows across 50 partitions (10 rows each)
statement ok
INSERT INTO t5 SELECT i, 'partition_' || (i % 50)::VARCHAR,
  list_value(sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT, sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(1, 501) t(i);

query I
SELECT count(DISTINCT cat) FROM t5;
----
50

query I
SELECT count(*) FROM t5;
----
500

# Verify filtered search on a few partitions
query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_0' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_25' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_49' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

statement ok
CHECKPOINT;

restart

# Verify all 50 partitions survived serialization (50 * 3 = 150 allocator_infos)
query I
SELECT count(*) FROM t5;
----
500

query I
SELECT count(DISTINCT cat) FROM t5;
----
50

query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_0' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_25' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

query I
SELECT count(*) FROM (SELECT id FROM t5 WHERE cat = 'partition_49' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

# Global search across 50 partitions
query I
SELECT count(*) FROM (SELECT id FROM t5 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 20);
----
20

# Delete some partitions after restart, then checkpoint again
statement ok
DELETE FROM t5 WHERE cat IN ('partition_0', 'partition_10', 'partition_20', 'partition_30', 'partition_40');

statement ok
CHECKPOINT;

restart

query I
SELECT count(DISTINCT cat) FROM t5;
----
45

query I
SELECT count(*) FROM t5;
----
450

query I
SELECT count(*) FROM (SELECT id FROM t5 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 20);
----
20

statement ok
DROP TABLE t5;
