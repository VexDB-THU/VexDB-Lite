# name: test/sql/vex/index/graph_index_copy.test
# description: Test COPY TO/FROM with graph index
# group: [vex]

require vex

require parquet

# ============================================================
# Setup
# ============================================================
statement ok
CREATE TABLE t_copy (id INTEGER, vec FLOAT[3]);

statement ok
CREATE INDEX idx_copy ON t_copy USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t_copy VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

# ============================================================
# Test 1: COPY TO CSV and reimport
# ============================================================
statement ok
COPY t_copy TO '__TEST_DIR__/vectors.csv' (HEADER, DELIMITER ',');

# Create a new table and import
statement ok
CREATE TABLE t_import (id INTEGER, vec FLOAT[3]);

statement ok
CREATE INDEX idx_import ON t_import USING GRAPH_INDEX (vec);

statement ok
COPY t_import FROM '__TEST_DIR__/vectors.csv' (HEADER, DELIMITER ',');

# Verify data and index work
query I
SELECT count(*) FROM t_import;
----
3

query I
SELECT id FROM t_import ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

# ============================================================
# Test 2: COPY TO Parquet and reimport
# ============================================================
statement ok
COPY t_copy TO '__TEST_DIR__/vectors.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE t_parquet (id INTEGER, vec FLOAT[3]);

statement ok
CREATE INDEX idx_parquet ON t_parquet USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t_parquet SELECT * FROM '__TEST_DIR__/vectors.parquet';

query I
SELECT count(*) FROM t_parquet;
----
3

query I
SELECT id FROM t_parquet ORDER BY l2_distance(vec, [0.0, 0.0, 1.0]::FLOAT[3]) LIMIT 1;
----
3

# ============================================================
# Test 3: INSERT INTO ... SELECT (table to table with index)
# ============================================================
statement ok
CREATE TABLE t_target (id INTEGER, vec FLOAT[3]);

statement ok
CREATE INDEX idx_target ON t_target USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t_target SELECT * FROM t_copy;

query I
SELECT count(*) FROM t_target;
----
3

query I
SELECT id FROM t_target ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOAT[3]) LIMIT 1;
----
2

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_target;

statement ok
DROP TABLE t_parquet;

statement ok
DROP TABLE t_import;

statement ok
DROP TABLE t_copy;
