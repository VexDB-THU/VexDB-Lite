# name: test/sql/vex/index/graph_index_dedup_benchmark.test_slow
# description: Dedup vs no-dedup: node count, storage, recall comparison
# group: [vex]
#
# Quantitative comparison of dedup ON (max_dedup=8) vs OFF (max_dedup=1)
# Measures: node_count reduction, recall quality, search correctness

require vex

# ============================================================
# Scenario A: High duplication (10 groups × 100 rows = 1000 rows)
# ============================================================

# --- A1: WITHOUT dedup ---
statement ok
CREATE TABLE t_nodup_a(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_nodup_a
SELECT i AS id,
  [sin(((i-1)//100)*0.5)::FLOAT, cos(((i-1)//100)*0.7)::FLOAT,
   sin(((i-1)//100)*1.1)::FLOAT, cos(((i-1)//100)*1.3)::FLOAT,
   sin(((i-1)//100)*1.7)::FLOAT, cos(((i-1)//100)*2.1)::FLOAT,
   sin(((i-1)//100)*2.3)::FLOAT, cos(((i-1)//100)*2.9)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_nodup_a ON t_nodup_a USING GRAPH_INDEX (vec) WITH (max_dedup = 1);

# --- A2: WITH dedup ---
statement ok
CREATE TABLE t_dedup_a(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_dedup_a
SELECT i AS id,
  [sin(((i-1)//100)*0.5)::FLOAT, cos(((i-1)//100)*0.7)::FLOAT,
   sin(((i-1)//100)*1.1)::FLOAT, cos(((i-1)//100)*1.3)::FLOAT,
   sin(((i-1)//100)*1.7)::FLOAT, cos(((i-1)//100)*2.1)::FLOAT,
   sin(((i-1)//100)*2.3)::FLOAT, cos(((i-1)//100)*2.9)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_dedup_a ON t_dedup_a USING GRAPH_INDEX (vec) WITH (max_dedup = 8);

# Compare node counts
# No dedup: node_count = 1000
query I
SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_nodup_a';
----
1000

# With dedup: node_count should be significantly less (10 unique vectors, but pipeline batching means ~20-80)
query I
SELECT node_count < 500 FROM vex_index_info() WHERE index_name = 'idx_dedup_a';
----
true

# Both must have all 1000 rows mapped
query II
SELECT
  (SELECT row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_nodup_a'),
  (SELECT row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_dedup_a');
----
1000	1000

# Node count reduction ratio
query I
SELECT (SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_dedup_a')
     < (SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_nodup_a');
----
true

# --- A3: Recall comparison (both vs brute force) ---
statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TABLE bf_a AS SELECT id FROM t_nodup_a
ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]::FLOATVECTOR(8)) LIMIT 20;

statement ok
RESET disabled_optimizers;

# No-dedup recall — disable optimizer to get deterministic brute-force results for fair comparison
# With highly duplicate data, ANN and brute-force may return different row IDs from the same vector groups
statement ok
SET disabled_optimizers='extension';

query I
SELECT COUNT(*) >= 18 FROM (
  SELECT id FROM t_nodup_a
  ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]::FLOATVECTOR(8)) LIMIT 20
) ann WHERE ann.id IN (SELECT id FROM bf_a);
----
true

# Dedup recall
query I
SELECT COUNT(*) >= 18 FROM (
  SELECT id FROM t_dedup_a
  ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]::FLOATVECTOR(8)) LIMIT 20
) ann WHERE ann.id IN (SELECT id FROM bf_a);
----
true

statement ok
RESET disabled_optimizers;

# All 1000 rows searchable in both — disable optimizer for full scan test
# (HNSW approximate search with k=1000 may not return all rows)
statement ok
SET disabled_optimizers='extension';

query I
SELECT COUNT(*) FROM (
  SELECT id FROM t_nodup_a
  ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]::FLOATVECTOR(8)) LIMIT 1000
);
----
1000

query I
SELECT COUNT(*) FROM (
  SELECT id FROM t_dedup_a
  ORDER BY l2_distance(vec, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]::FLOATVECTOR(8)) LIMIT 1000
);
----
1000

statement ok
RESET disabled_optimizers;

statement ok
DROP TABLE bf_a;

statement ok
DROP TABLE t_nodup_a;

statement ok
DROP TABLE t_dedup_a;

# ============================================================
# Scenario B: Moderate duplication (100 groups × 10 rows = 1000 rows)
# ============================================================

statement ok
CREATE TABLE t_nodup_b(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_nodup_b
SELECT i AS id,
  [sin(((i-1)//10)*0.3)::FLOAT, cos(((i-1)//10)*0.5)::FLOAT,
   sin(((i-1)//10)*0.7)::FLOAT, cos(((i-1)//10)*0.9)::FLOAT,
   sin(((i-1)//10)*1.1)::FLOAT, cos(((i-1)//10)*1.3)::FLOAT,
   sin(((i-1)//10)*1.5)::FLOAT, cos(((i-1)//10)*1.7)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_nodup_b ON t_nodup_b USING GRAPH_INDEX (vec) WITH (max_dedup = 1);

statement ok
CREATE TABLE t_dedup_b(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_dedup_b
SELECT i AS id,
  [sin(((i-1)//10)*0.3)::FLOAT, cos(((i-1)//10)*0.5)::FLOAT,
   sin(((i-1)//10)*0.7)::FLOAT, cos(((i-1)//10)*0.9)::FLOAT,
   sin(((i-1)//10)*1.1)::FLOAT, cos(((i-1)//10)*1.3)::FLOAT,
   sin(((i-1)//10)*1.5)::FLOAT, cos(((i-1)//10)*1.7)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_dedup_b ON t_dedup_b USING GRAPH_INDEX (vec) WITH (max_dedup = 8);

# No dedup: 1000 nodes
query I
SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_nodup_b';
----
1000

# With dedup: significantly fewer (100 unique vectors × ~1-2 nodes each)
query I
SELECT node_count < 500 FROM vex_index_info() WHERE index_name = 'idx_dedup_b';
----
true

# Recall check
statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TABLE bf_b AS SELECT id FROM t_nodup_b
ORDER BY l2_distance(vec, [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0]::FLOATVECTOR(8)) LIMIT 20;

statement ok
RESET disabled_optimizers;

query I
SELECT COUNT(*) >= 18 FROM (
  SELECT id FROM t_dedup_b
  ORDER BY l2_distance(vec, [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0]::FLOATVECTOR(8)) LIMIT 20
) ann WHERE ann.id IN (SELECT id FROM bf_b);
----
true

statement ok
DROP TABLE bf_b;

statement ok
DROP TABLE t_nodup_b;

statement ok
DROP TABLE t_dedup_b;

# ============================================================
# Scenario C: No duplication (1000 unique vectors)
# Dedup should have zero overhead — node_count identical
# ============================================================

statement ok
CREATE TABLE t_nodup_c(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_nodup_c
SELECT i AS id,
  [sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT,
   sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT,
   sin(i*0.5)::FLOAT, cos(i*0.6)::FLOAT,
   sin(i*0.7)::FLOAT, cos(i*0.8)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_nodup_c ON t_nodup_c USING GRAPH_INDEX (vec) WITH (max_dedup = 1);

statement ok
CREATE TABLE t_dedup_c(id INT, vec FLOATVECTOR(8));

statement ok
INSERT INTO t_dedup_c
SELECT i AS id,
  [sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT,
   sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT,
   sin(i*0.5)::FLOAT, cos(i*0.6)::FLOAT,
   sin(i*0.7)::FLOAT, cos(i*0.8)::FLOAT]::FLOATVECTOR(8) AS vec
FROM range(1, 1001) t(i);

statement ok
CREATE INDEX idx_dedup_c ON t_dedup_c USING GRAPH_INDEX (vec) WITH (max_dedup = 8);

# No duplication → node_count should be identical
query I
SELECT (SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_nodup_c')
     = (SELECT node_count FROM vex_index_info() WHERE index_name = 'idx_dedup_c');
----
true

statement ok
DROP TABLE t_nodup_c;

statement ok
DROP TABLE t_dedup_c;

