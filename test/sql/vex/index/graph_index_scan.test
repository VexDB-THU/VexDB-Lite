# name: test/sql/vex/index/graph_index_scan.test
# description: Test graph index scan
# group: [vex]

require vex

# Create a simple table with vectors
statement ok
CREATE TABLE items (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO items VALUES (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3));

statement ok
INSERT INTO items VALUES (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
INSERT INTO items VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

# Create the index
statement ok
CREATE INDEX idx_items ON items USING GRAPH_INDEX (vec);

# Simple select query
query II
SELECT id, vec FROM items ORDER BY id;
----
1	[1.0, 0.0, 0.0]
2	[0.0, 1.0, 0.0]
3	[0.0, 0.0, 1.0]
