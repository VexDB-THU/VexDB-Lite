# name: test/sql/vex/index/graph_index_transaction.test
# description: Test graph index transaction semantics (INSERT, DELETE, COMMIT)
# group: [vex]
# NOTE: GraphIndex does not fully participate in MVCC rollback.
#       Each test uses an independent table to avoid state accumulation.

require vex

# ============================================================
# Test 1: INSERT then search (auto-commit)
# ============================================================
statement ok
CREATE TABLE t1 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx1 ON t1 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t1 VALUES (4, [0.99, 0.01, 0.0]::FLOATVECTOR(3));

# id=4 is closest to [0.98, 0.02, 0]
query I
SELECT id FROM t1 ORDER BY l2_distance(vec, [0.98, 0.02, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
4

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: DELETE then search (auto-commit)
# ============================================================
statement ok
CREATE TABLE t2 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx2 ON t2 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t2 WHERE id = 1;

# id=1 deleted; closest to [1,0,0] should not be id=1
query I
SELECT count(*) FROM t2 WHERE id = 1;
----
0

query I
SELECT count(*) FROM t2;
----
2

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: BEGIN + INSERT + COMMIT
# ============================================================
statement ok
CREATE TABLE t3 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx3 ON t3 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t3 VALUES (3, [0.99, 0.0, 0.01]::FLOATVECTOR(3));

statement ok
COMMIT;

# id=3 should be findable after commit
query I
SELECT id FROM t3 ORDER BY l2_distance(vec, [0.98, 0.0, 0.02]::FLOATVECTOR(3)) LIMIT 1;
----
3

statement ok
DROP TABLE t3;

# ============================================================
# Test 4: BEGIN + DELETE + COMMIT
# ============================================================
statement ok
CREATE TABLE t4 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t4 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx4 ON t4 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t4 WHERE id = 1;

statement ok
COMMIT;

# id=1 should be gone after commit
query I
SELECT count(*) FROM t4 WHERE id = 1;
----
0

statement ok
DROP TABLE t4;

# ============================================================
# Test 5: BEGIN + INSERT + DELETE + COMMIT (combined ops)
# ============================================================
statement ok
CREATE TABLE t5 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t5 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx5 ON t5 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t5 VALUES (4, [0.9, 0.0, 0.0]::FLOATVECTOR(3));

statement ok
DELETE FROM t5 WHERE id = 2;

statement ok
COMMIT;

# After commit: id=2 gone, id=4 present
query I
SELECT count(*) FROM t5;
----
3

query I
SELECT count(*) FROM t5 WHERE id = 2;
----
0

query I
SELECT count(*) FROM t5 WHERE id = 4;
----
1

statement ok
DROP TABLE t5;

# ============================================================
# Test 6: CREATE INDEX inside transaction, then ROLLBACK
# ============================================================
statement ok
CREATE TABLE t6 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t6 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
BEGIN;

statement ok
CREATE INDEX idx6 ON t6 USING GRAPH_INDEX (vec);

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx6';
----
1

statement ok
ROLLBACK;

# Index should not exist after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx6';
----
0

# Data should still be accessible without index
query I
SELECT id FROM t6 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

statement ok
DROP TABLE t6;

# ============================================================
# Test 7: DROP INDEX inside transaction, then ROLLBACK
# ============================================================
statement ok
CREATE TABLE t7 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t7 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx7 ON t7 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DROP INDEX idx7;

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx7';
----
0

statement ok
ROLLBACK;

# Index should be restored after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx7';
----
1

statement ok
DROP TABLE t7;

# ============================================================
# Test 8: Multiple sequential commits
# ============================================================
statement ok
CREATE TABLE t8 (id INTEGER, vec FLOATVECTOR(3));

statement ok
CREATE INDEX idx8 ON t8 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t8 VALUES (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3));

statement ok
INSERT INTO t8 VALUES (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
INSERT INTO t8 VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

query I
SELECT count(*) FROM t8;
----
3

query I
SELECT id FROM t8 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

statement ok
DROP TABLE t8;
