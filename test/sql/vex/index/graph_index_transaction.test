# name: test/sql/vex/index/graph_index_transaction.test
# description: Test graph index transaction semantics (INSERT, DELETE, COMMIT)
# group: [vex]
# NOTE: GraphIndex does not fully participate in MVCC rollback.
#       Each test uses an independent table to avoid state accumulation.

require vex

# ============================================================
# Test 1: INSERT then search (auto-commit)
# ============================================================
statement ok
CREATE TABLE t1 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx1 ON t1 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t1 VALUES (4, [0.99, 0.01, 0.0]::FLOAT[3]);

# id=4 is closest to [0.98, 0.02, 0]
query I
SELECT id FROM t1 ORDER BY l2_distance(vec, [0.98, 0.02, 0.0]::FLOAT[3]) LIMIT 1;
----
4

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: DELETE then search (auto-commit)
# ============================================================
statement ok
CREATE TABLE t2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx2 ON t2 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t2 WHERE id = 1;

# id=1 deleted; closest to [1,0,0] should not be id=1
query I
SELECT count(*) FROM t2 WHERE id = 1;
----
0

query I
SELECT count(*) FROM t2;
----
2

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: BEGIN + INSERT + COMMIT
# ============================================================
statement ok
CREATE TABLE t3 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx3 ON t3 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t3 VALUES (3, [0.99, 0.0, 0.01]::FLOAT[3]);

statement ok
COMMIT;

# id=3 should be findable after commit
query I
SELECT id FROM t3 ORDER BY l2_distance(vec, [0.98, 0.0, 0.02]::FLOAT[3]) LIMIT 1;
----
3

statement ok
DROP TABLE t3;

# ============================================================
# Test 4: BEGIN + DELETE + COMMIT
# ============================================================
statement ok
CREATE TABLE t4 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t4 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx4 ON t4 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t4 WHERE id = 1;

statement ok
COMMIT;

# id=1 should be gone after commit
query I
SELECT count(*) FROM t4 WHERE id = 1;
----
0

statement ok
DROP TABLE t4;

# ============================================================
# Test 5: BEGIN + INSERT + DELETE + COMMIT (combined ops)
# ============================================================
statement ok
CREATE TABLE t5 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t5 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx5 ON t5 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t5 VALUES (4, [0.9, 0.0, 0.0]::FLOAT[3]);

statement ok
DELETE FROM t5 WHERE id = 2;

statement ok
COMMIT;

# After commit: id=2 gone, id=4 present
query I
SELECT count(*) FROM t5;
----
3

query I
SELECT count(*) FROM t5 WHERE id = 2;
----
0

query I
SELECT count(*) FROM t5 WHERE id = 4;
----
1

statement ok
DROP TABLE t5;

# ============================================================
# Test 6: CREATE INDEX inside transaction, then ROLLBACK
# ============================================================
statement ok
CREATE TABLE t6 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t6 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
BEGIN;

statement ok
CREATE INDEX idx6 ON t6 USING GRAPH_INDEX (vec);

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx6';
----
1

statement ok
ROLLBACK;

# Index should not exist after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx6';
----
0

# Data should still be accessible without index
query I
SELECT id FROM t6 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

statement ok
DROP TABLE t6;

# ============================================================
# Test 7: DROP INDEX inside transaction, then ROLLBACK
# ============================================================
statement ok
CREATE TABLE t7 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t7 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx7 ON t7 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DROP INDEX idx7;

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx7';
----
0

statement ok
ROLLBACK;

# Index should be restored after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx7';
----
1

statement ok
DROP TABLE t7;

# ============================================================
# Test 8: Multiple sequential commits
# ============================================================
statement ok
CREATE TABLE t8 (id INTEGER, vec FLOAT[3]);

statement ok
CREATE INDEX idx8 ON t8 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t8 VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]);

statement ok
INSERT INTO t8 VALUES (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
INSERT INTO t8 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3]);

query I
SELECT count(*) FROM t8;
----
3

query I
SELECT id FROM t8 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

statement ok
DROP TABLE t8;

# ============================================================
# Test 9: BEGIN + INSERT + ROLLBACK (data should not be visible)
# ============================================================
statement ok
CREATE TABLE t9 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t9 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx9 ON t9 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t9 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
INSERT INTO t9 VALUES (4, [0.5, 0.5, 0.0]::FLOAT[3]);

statement ok
ROLLBACK;

# After rollback: only 2 rows, inserted rows should not be visible
query I
SELECT count(*) FROM t9;
----
2

# Search should still work correctly
query I
SELECT id FROM t9 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

query I
SELECT id FROM t9 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOAT[3]) LIMIT 1;
----
2

statement ok
DROP TABLE t9;

# ============================================================
# Test 10: BEGIN + DELETE + ROLLBACK (deleted data should still be visible)
# ============================================================
statement ok
CREATE TABLE t10 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t10 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx10 ON t10 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t10 WHERE id = 1;

# Within transaction: only 2 rows visible
query I
SELECT count(*) FROM t10;
----
2

statement ok
ROLLBACK;

# After rollback: all 3 rows should be visible again
query I
SELECT count(*) FROM t10;
----
3

# id=1 should be searchable again
query I
SELECT id FROM t10 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

statement ok
DROP TABLE t10;

# ============================================================
# Test 11: BEGIN + INSERT + DELETE + ROLLBACK (mixed ops rollback)
# ============================================================
statement ok
CREATE TABLE t11 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t11 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx11 ON t11 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t11 VALUES (4, [0.5, 0.5, 0.0]::FLOAT[3]);

statement ok
DELETE FROM t11 WHERE id = 2;

statement ok
ROLLBACK;

# After rollback: original 3 rows, no id=4, id=2 restored
query I
SELECT count(*) FROM t11;
----
3

query I
SELECT count(*) FROM t11 WHERE id = 2;
----
1

query I
SELECT count(*) FROM t11 WHERE id = 4;
----
0

statement ok
DROP TABLE t11;

# ============================================================
# Test 12: Consecutive ROLLBACK then COMMIT
# ============================================================
statement ok
CREATE TABLE t12 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t12 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx12 ON t12 USING GRAPH_INDEX (vec);

# First transaction: rollback
statement ok
BEGIN;

statement ok
INSERT INTO t12 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM t12;
----
2

# Second transaction: commit
statement ok
BEGIN;

statement ok
INSERT INTO t12 VALUES (4, [0.5, 0.5, 0.5]::FLOAT[3]);

statement ok
COMMIT;

query I
SELECT count(*) FROM t12;
----
3

query I
SELECT count(*) FROM t12 WHERE id = 3;
----
0

query I
SELECT count(*) FROM t12 WHERE id = 4;
----
1

# Search should find id=4
query I
SELECT id FROM t12 ORDER BY l2_distance(vec, [0.5, 0.5, 0.5]::FLOAT[3]) LIMIT 1;
----
4

statement ok
DROP TABLE t12;

# ============================================================
# Test 13: Vector search within uncommitted INSERT transaction
# The optimizer must NOT use index-only scan when LocalStorage
# has uncommitted data, otherwise newly inserted rows are missed.
# ============================================================
statement ok
CREATE TABLE t13 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t13 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx13 ON t13 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
INSERT INTO t13 VALUES (4, [0.99, 0.01, 0.0]::FLOAT[3]);

# Within the uncommitted transaction, vector search must see id=4
query I
SELECT id FROM t13 ORDER BY l2_distance(vec, [0.98, 0.02, 0.0]::FLOAT[3]) LIMIT 1;
----
4

# Top-2 should include the uncommitted row
query I
SELECT count(*) FROM (
  SELECT id FROM t13
  ORDER BY l2_distance(vec, [0.98, 0.02, 0.0]::FLOAT[3])
  LIMIT 2
) t;
----
2

statement ok
COMMIT;

# After commit, search should still find id=4
query I
SELECT id FROM t13 ORDER BY l2_distance(vec, [0.98, 0.02, 0.0]::FLOAT[3]) LIMIT 1;
----
4

statement ok
DROP TABLE t13;

# ============================================================
# Test 14: Vector search within uncommitted DELETE transaction
# ============================================================
statement ok
CREATE TABLE t14 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t14 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx14 ON t14 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t14 WHERE id = 1;

# Within the uncommitted transaction, vector search must NOT find id=1
query I
SELECT id FROM t14 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
2

statement ok
COMMIT;

statement ok
DROP TABLE t14;

# ============================================================
# Test 15: Vector search within uncommitted INSERT+DELETE transaction
# ============================================================
statement ok
CREATE TABLE t15 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t15 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx15 ON t15 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

# Delete id=1 and insert id=4 (closer to [1,0,0] than id=2)
statement ok
DELETE FROM t15 WHERE id = 1;

statement ok
INSERT INTO t15 VALUES (4, [0.95, 0.05, 0.0]::FLOAT[3]);

# Vector search should find id=4 (not deleted id=1)
query I
SELECT id FROM t15 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
4

# Total count should be 3 (original 3 - 1 deleted + 1 inserted)
query I
SELECT count(*) FROM t15;
----
3

statement ok
COMMIT;

statement ok
DROP TABLE t15;
