# name: test/sql/vex/index/hybrid_index_restart_search.test
# description: Test hybrid index filtered ANN search after restart
# group: [vex]

require vex

load __TEST_DIR__/hybrid_index_restart_search.db

statement ok
CREATE TABLE items (id INTEGER, category VARCHAR, vec FLOAT[3]);

statement ok
INSERT INTO items VALUES
  (1, 'A', [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, 'A', [0.9, 0.1, 0.0]::FLOAT[3]),
  (3, 'B', [0.0, 1.0, 0.0]::FLOAT[3]),
  (4, 'B', [0.0, 0.9, 0.1]::FLOAT[3]),
  (5, 'A', [0.0, 0.0, 1.0]::FLOAT[3]),
  (6, 'B', [0.1, 0.0, 0.9]::FLOAT[3]);

statement ok
CREATE INDEX idx ON items USING HYBRID_INDEX (vec, category);

# Verify filtered search before restart
query I
SELECT id FROM items WHERE category = 'A' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
1
2

statement ok
CHECKPOINT;

restart

# Verify index exists
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# Filtered ANN search after restart
query I
SELECT id FROM items WHERE category = 'A' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
1
2
