# name: test/sql/vex/index/hybrid_index_wal_transaction.test
# description: Test hybrid index WAL recovery combined with transaction semantics
# group: [vex]

require vex

# ============================================================
# Test 1: COMMIT + WAL restart
# ============================================================
load __TEST_DIR__/wal_hybrid_1.db

statement ok
CREATE TABLE h1 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
CREATE INDEX idx1 ON h1 USING HYBRID_INDEX (vec, category);

statement ok
INSERT INTO h1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
BEGIN;

statement ok
INSERT INTO h1 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3], 'A');

statement ok
COMMIT;

restart

query I
SELECT count(*) FROM h1;
----
3

query I
SELECT count(*) FROM h1 WHERE id = 3;
----
1

statement ok
DROP TABLE h1;

# ============================================================
# Test 2: ROLLBACK + COMMIT + WAL restart
# ============================================================
load __TEST_DIR__/wal_hybrid_2.db

statement ok
CREATE TABLE h2 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
CREATE INDEX idx2 ON h2 USING HYBRID_INDEX (vec, category);

statement ok
INSERT INTO h2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

# Rollback
statement ok
BEGIN;

statement ok
INSERT INTO h2 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3], 'A');

statement ok
ROLLBACK;

# Commit
statement ok
BEGIN;

statement ok
INSERT INTO h2 VALUES (4, [0.5, 0.5, 0.0]::FLOAT[3], 'B');

statement ok
COMMIT;

restart

query I
SELECT count(*) FROM h2;
----
3

query I
SELECT count(*) FROM h2 WHERE id = 3;
----
0

query I
SELECT count(*) FROM h2 WHERE id = 4;
----
1

statement ok
DROP TABLE h2;

# ============================================================
# Test 3: DELETE + COMMIT + WAL restart
# ============================================================
load __TEST_DIR__/wal_hybrid_3.db

statement ok
CREATE TABLE h3 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx3 ON h3 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
DELETE FROM h3 WHERE id = 2;

statement ok
COMMIT;

restart

query I
SELECT count(*) FROM h3;
----
2

query I
SELECT count(*) FROM h3 WHERE id = 2;
----
0

statement ok
DROP TABLE h3;

# ============================================================
# Test 4: Checkpoint + more ops + WAL restart
# ============================================================
load __TEST_DIR__/wal_hybrid_4.db

statement ok
CREATE TABLE h4 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h4 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx4 ON h4 USING HYBRID_INDEX (vec, category);

statement ok
CHECKPOINT;

# More ops after checkpoint
statement ok
INSERT INTO h4 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3], 'A');

statement ok
DELETE FROM h4 WHERE id = 1;

restart

query I
SELECT count(*) FROM h4;
----
2

query I
SELECT count(*) FROM h4 WHERE id = 1;
----
0

query I
SELECT count(*) FROM h4 WHERE id = 3;
----
1

statement ok
DROP TABLE h4;

# ============================================================
# Test 5: Multiple restarts without checkpoint
# ============================================================
load __TEST_DIR__/wal_hybrid_5.db

statement ok
CREATE TABLE h5 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
CREATE INDEX idx5 ON h5 USING HYBRID_INDEX (vec, category);

statement ok
INSERT INTO h5 VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A');

restart

statement ok
INSERT INTO h5 VALUES (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

restart

statement ok
INSERT INTO h5 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3], 'A');

restart

query I
SELECT count(*) FROM h5;
----
3

statement ok
DROP TABLE h5;
