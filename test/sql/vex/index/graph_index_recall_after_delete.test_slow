# ============================================================
# Part B: Recovery — insert fresh data after heavy deletion
# ============================================================
statement ok
INSERT INTO recall_strong
SELECT i AS id,
  [sin(i*0.019)::FLOAT, cos(i*0.029)::FLOAT, sin(i*0.039+1)::FLOAT, cos(i*0.049+2)::FLOAT,
   sin(i*0.059+3)::FLOAT, cos(i*0.069+4)::FLOAT, sin(i*0.079+5)::FLOAT, cos(i*0.089+6)::FLOAT,
   sin(i*0.099+7)::FLOAT, cos(i*0.109+8)::FLOAT, sin(i*0.119+9)::FLOAT, cos(i*0.129+10)::FLOAT,
   sin(i*0.139+11)::FLOAT, cos(i*0.149+12)::FLOAT, sin(i*0.159+13)::FLOAT, cos(i*0.169+14)::FLOAT,
   sin(i*0.179+15)::FLOAT, cos(i*0.189+16)::FLOAT, sin(i*0.199+17)::FLOAT, cos(i*0.209+18)::FLOAT,
   sin(i*0.219+19)::FLOAT, cos(i*0.229+20)::FLOAT, sin(i*0.239+21)::FLOAT, cos(i*0.249+22)::FLOAT,
   sin(i*0.259+23)::FLOAT, cos(i*0.269+24)::FLOAT, sin(i*0.279+25)::FLOAT, cos(i*0.289+26)::FLOAT,
   sin(i*0.299+27)::FLOAT, cos(i*0.309+28)::FLOAT, sin(i*0.319+29)::FLOAT, cos(i*0.329+30)::FLOAT
  ]::FLOAT[32] AS vec
FROM range(20001, 25001) t(i);

statement ok
DROP TABLE bf_s;

statement ok
CREATE TABLE bf_s AS SELECT id FROM recall_strong
ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10;


query I
SELECT COUNT(*) >= 8 FROM (
  SELECT id FROM recall_strong
  ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10
) ann WHERE ann.id IN (SELECT id FROM bf_s);
----
true

