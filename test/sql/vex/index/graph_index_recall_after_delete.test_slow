  SELECT id FROM recall_weak
  ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10
) ann WHERE ann.id IN (SELECT id FROM bf_w);
----
true

# Second query at 50% delete (weak)
statement ok
CREATE TABLE bf_w2 AS SELECT id FROM recall_weak
ORDER BY l2_distance(vec, [0.9,0.8,0.7,0.6,0.5,0.4,0.3,0.2,0.1,0.05,0.85,0.75,0.65,0.55,0.45,0.35,0.25,0.15,0.95,0.88,0.78,0.68,0.58,0.48,0.38,0.28,0.18,0.08,0.92,0.82,0.72,0.62]::FLOAT[32]) LIMIT 10;


query I
SELECT COUNT(*) >= 4 FROM (
  SELECT id FROM recall_weak
  ORDER BY l2_distance(vec, [0.9,0.8,0.7,0.6,0.5,0.4,0.3,0.2,0.1,0.05,0.85,0.75,0.65,0.55,0.45,0.35,0.25,0.15,0.95,0.88,0.78,0.68,0.58,0.48,0.38,0.28,0.18,0.08,0.92,0.82,0.72,0.62]::FLOAT[32]) LIMIT 10
