# name: test/sql/vex/index/graph_index_recall_after_delete.test_slow
# description: Large-scale ANN recall@10 vs brute-force after progressive deletions
# group: [vex]
#
# Tests with both strong (m=16) and weak (m=4) graph parameters to expose degradation.
# ef_search is fixed at 40 (DEFAULT_EF_SEARCH) by the optimizer.

require vex

# This test validates data integrity after progressive deletes via brute-force
# distance comparisons. Disable VEX optimizer so all ORDER BY distance queries
# use sequential scan (brute force), not ANN index search.
statement ok
SET disabled_optimizers='extension';

# ============================================================
# Part A: Weak graph (m=4, ef_construction=16) — most likely to degrade
# 10000 rows, 32-dim
# ============================================================
statement ok
CREATE TABLE recall_weak AS
SELECT i AS id,
  [sin(i*0.017)::FLOAT, cos(i*0.023)::FLOAT, sin(i*0.031+1)::FLOAT, cos(i*0.037+2)::FLOAT,
   sin(i*0.041+3)::FLOAT, cos(i*0.043+4)::FLOAT, sin(i*0.047+5)::FLOAT, cos(i*0.053+6)::FLOAT,
   sin(i*0.059+7)::FLOAT, cos(i*0.061+8)::FLOAT, sin(i*0.067+9)::FLOAT, cos(i*0.071+10)::FLOAT,
   sin(i*0.073+11)::FLOAT, cos(i*0.079+12)::FLOAT, sin(i*0.083+13)::FLOAT, cos(i*0.089+14)::FLOAT,
   sin(i*0.097+15)::FLOAT, cos(i*0.101+16)::FLOAT, sin(i*0.103+17)::FLOAT, cos(i*0.107+18)::FLOAT,
   sin(i*0.109+19)::FLOAT, cos(i*0.113+20)::FLOAT, sin(i*0.127+21)::FLOAT, cos(i*0.131+22)::FLOAT,
   sin(i*0.137+23)::FLOAT, cos(i*0.139+24)::FLOAT, sin(i*0.149+25)::FLOAT, cos(i*0.151+26)::FLOAT,
   sin(i*0.157+27)::FLOAT, cos(i*0.163+28)::FLOAT, sin(i*0.167+29)::FLOAT, cos(i*0.173+30)::FLOAT
  ]::FLOAT[32] AS vec
FROM range(1, 10001) t(i);

# Weak graph: m=4 means only 8 level-0 neighbors, ef_construction=16 means poor build quality
statement ok
CREATE INDEX idx_weak ON recall_weak USING GRAPH_INDEX (vec) WITH (m = 4, ef_construction = 16);

# --- Baseline (weak graph, 10000 rows) ---
statement ok
CREATE TABLE bf_w AS SELECT id FROM recall_weak
ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10;


# Even weak graph should get >= 7 on fresh data
query I
SELECT COUNT(*) >= 7 FROM (
  SELECT id FROM recall_weak
  ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10
) ann WHERE ann.id IN (SELECT id FROM bf_w);
----
true

# --- Delete 30% (weak graph) ---
statement ok
DELETE FROM recall_weak WHERE id % 10 IN (0, 3, 7);

statement ok
DROP TABLE bf_w;

statement ok
CREATE TABLE bf_w AS SELECT id FROM recall_weak
ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10;


query I
SELECT COUNT(*) >= 5 FROM (
  SELECT id FROM recall_weak
  ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10
) ann WHERE ann.id IN (SELECT id FROM bf_w);
----
true

# --- Delete 50% (weak graph) ---
statement ok
DELETE FROM recall_weak WHERE id % 2 = 1;

statement ok
DROP TABLE bf_w;

statement ok
CREATE TABLE bf_w AS SELECT id FROM recall_weak
ORDER BY l2_distance(vec, [0.3,-0.5,0.7,-0.2,0.4,-0.6,0.8,-0.1,0.5,-0.3,0.6,-0.4,0.2,-0.7,0.9,-0.8,0.1,-0.9,0.35,-0.15,0.55,-0.45,0.25,-0.65,0.85,-0.75,0.05,-0.95,0.42,-0.32,0.62,-0.52]::FLOAT[32]) LIMIT 10;


query I
