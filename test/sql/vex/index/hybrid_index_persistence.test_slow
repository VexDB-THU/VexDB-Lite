# name: test/sql/vex/index/hybrid_index_persistence.test_slow
# description: HybridIndex persistence - checkpoint, restart, WAL replay with delete
# group: [vex]

require vex

load __TEST_DIR__/hybrid_persist_slow.db

# ============================================================
# Phase 1: Create and populate
# ============================================================
statement ok
CREATE TABLE hp (id INTEGER PRIMARY KEY, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx ON hp USING HYBRID_INDEX (vec, cat);

statement ok
INSERT INTO hp SELECT i, 'cat_a', list_value(sin(i*0.1)::FLOAT, cos(i*0.2)::FLOAT, sin(i*0.3)::FLOAT, cos(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(1, 101) t(i);

statement ok
INSERT INTO hp SELECT i, 'cat_b', list_value(cos(i*0.1)::FLOAT, sin(i*0.2)::FLOAT, cos(i*0.3)::FLOAT, sin(i*0.4)::FLOAT)::FLOATVECTOR(4)
FROM range(101, 201) t(i);

statement ok
INSERT INTO hp SELECT i, 'cat_c', list_value(sin(i*0.5)::FLOAT, cos(i*0.6)::FLOAT, sin(i*0.7)::FLOAT, cos(i*0.8)::FLOAT)::FLOATVECTOR(4)
FROM range(201, 301) t(i);

query I
SELECT count(*) FROM hp;
----
300

# ============================================================
# Phase 2: Checkpoint + restart, verify all partitions
# ============================================================
statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM hp;
----
300

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_a' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_b' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_c' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Global search
query I
SELECT count(*) FROM (SELECT id FROM hp ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 15);
----
15

# ============================================================
# Phase 3: Delete from one partition, checkpoint, restart
# ============================================================
statement ok
DELETE FROM hp WHERE cat = 'cat_a' AND id % 2 = 0;

query I
SELECT count(*) FROM hp WHERE cat = 'cat_a';
----
50

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM hp WHERE cat = 'cat_a';
----
50

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_a' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# Other partitions intact
query I
SELECT count(*) FROM hp WHERE cat = 'cat_b';
----
100

query I
SELECT count(*) FROM hp WHERE cat = 'cat_c';
----
100

# ============================================================
# Phase 4: Delete entire partition, checkpoint, restart
# ============================================================
statement ok
DELETE FROM hp WHERE cat = 'cat_b';

statement ok
CHECKPOINT;

restart

query I
SELECT count(*) FROM hp WHERE cat = 'cat_b';
----
0

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_b' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
0

# Remaining partitions
query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_a' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_c' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 5);
----
5

# ============================================================
# Phase 5: Reinsert into deleted partition, no checkpoint, restart (WAL replay)
# ============================================================
statement ok
INSERT INTO hp SELECT i, 'cat_b', list_value(cos(i*0.3)::FLOAT, sin(i*0.4)::FLOAT, cos(i*0.5)::FLOAT, sin(i*0.6)::FLOAT)::FLOATVECTOR(4)
FROM range(301, 401) t(i);

query I
SELECT count(*) FROM hp WHERE cat = 'cat_b';
----
100

# NO CHECKPOINT - test WAL replay
restart

query I
SELECT count(*) FROM hp WHERE cat = 'cat_b';
----
100

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_b' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# ============================================================
# Phase 6: Delete + insert without checkpoint (WAL replay)
# ============================================================
statement ok
DELETE FROM hp WHERE cat = 'cat_c' AND id BETWEEN 201 AND 250;

statement ok
INSERT INTO hp SELECT i, 'cat_c', list_value(sin(i)::FLOAT, cos(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(401, 451) t(i);

# NO CHECKPOINT
restart

query I
SELECT count(*) FROM hp WHERE cat = 'cat_c';
----
100

query I
SELECT count(*) FROM (SELECT id FROM hp WHERE cat = 'cat_c' ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# ============================================================
# Phase 7: Cross-partition delete, checkpoint, restart
# ============================================================
statement ok
DELETE FROM hp WHERE id % 5 = 0;

statement ok
CHECKPOINT;

restart

statement ok
SELECT count(*) FROM hp;

query I
SELECT count(*) FROM (SELECT id FROM hp ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# ============================================================
# Phase 8: Drop index, recreate, restart
# ============================================================
statement ok
DROP INDEX idx;

statement ok
CREATE INDEX idx2 ON hp USING HYBRID_INDEX (vec, cat);

query I
SELECT count(*) FROM (SELECT id FROM hp ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

restart

query I
SELECT count(*) FROM (SELECT id FROM hp ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 10);
----
10

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE hp;
