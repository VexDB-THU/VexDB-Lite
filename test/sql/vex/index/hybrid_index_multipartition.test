# name: test/sql/vex/index/hybrid_index_multipartition.test
# description: Test hybrid index with many partitions, filtered/global search, and partition deletion
# group: [vex]

require vex

# Create table with 6 category partitions
statement ok
CREATE TABLE items (id INTEGER, category VARCHAR, vec FLOATVECTOR(4));

# Insert 24 rows spread across 6 partitions (4 rows each)
statement ok
INSERT INTO items VALUES
  (1,  'books',       [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (2,  'books',       [0.9, 0.1, 0.0, 0.0]::FLOATVECTOR(4)),
  (3,  'books',       [0.8, 0.2, 0.0, 0.0]::FLOATVECTOR(4)),
  (4,  'books',       [0.7, 0.3, 0.0, 0.0]::FLOATVECTOR(4)),
  (5,  'movies',      [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (6,  'movies',      [0.0, 0.9, 0.1, 0.0]::FLOATVECTOR(4)),
  (7,  'movies',      [0.0, 0.8, 0.2, 0.0]::FLOATVECTOR(4)),
  (8,  'movies',      [0.1, 0.7, 0.2, 0.0]::FLOATVECTOR(4)),
  (9,  'music',       [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4)),
  (10, 'music',       [0.0, 0.0, 0.9, 0.1]::FLOATVECTOR(4)),
  (11, 'music',       [0.0, 0.1, 0.8, 0.1]::FLOATVECTOR(4)),
  (12, 'music',       [0.1, 0.0, 0.7, 0.2]::FLOATVECTOR(4)),
  (13, 'games',       [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4)),
  (14, 'games',       [0.0, 0.0, 0.1, 0.9]::FLOATVECTOR(4)),
  (15, 'games',       [0.0, 0.1, 0.0, 0.9]::FLOATVECTOR(4)),
  (16, 'games',       [0.1, 0.0, 0.0, 0.9]::FLOATVECTOR(4)),
  (17, 'sports',      [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4)),
  (18, 'sports',      [0.4, 0.6, 0.0, 0.0]::FLOATVECTOR(4)),
  (19, 'sports',      [0.6, 0.4, 0.0, 0.0]::FLOATVECTOR(4)),
  (20, 'sports',      [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4)),
  (21, 'travel',      [0.0, 0.0, 0.5, 0.5]::FLOATVECTOR(4)),
  (22, 'travel',      [0.0, 0.1, 0.4, 0.5]::FLOATVECTOR(4)),
  (23, 'travel',      [0.1, 0.0, 0.5, 0.4]::FLOATVECTOR(4)),
  (24, 'travel',      [0.0, 0.0, 0.6, 0.4]::FLOATVECTOR(4));

# Create hybrid index
statement ok
CREATE INDEX idx_hybrid ON items USING HYBRID_INDEX (vec, category);

# Verify index exists
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_hybrid';
----
1

# =============================================================================
# Filtered search on each partition
# =============================================================================

# books: closest to [1,0,0,0] -> id=1
query I
SELECT id FROM items
WHERE category = 'books'
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
1

# movies: closest to [0,1,0,0] -> id=5
query I
SELECT id FROM items
WHERE category = 'movies'
ORDER BY l2_distance(vec, [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
5

# music: closest to [0,0,1,0] -> id=9
query I
SELECT id FROM items
WHERE category = 'music'
ORDER BY l2_distance(vec, [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
9

# games: closest to [0,0,0,1] -> id=13
query I
SELECT id FROM items
WHERE category = 'games'
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4))
LIMIT 1;
----
13

# sports: closest to [0.5,0.5,0,0] -> id=17 or id=20 (both identical)
# Use top-2 to verify both come from sports
query II
SELECT id, category FROM items
WHERE category = 'sports'
ORDER BY l2_distance(vec, [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 2;
----
17	sports
20	sports

# travel: closest to [0,0,0.5,0.5] -> id=21
query I
SELECT id FROM items
WHERE category = 'travel'
ORDER BY l2_distance(vec, [0.0, 0.0, 0.5, 0.5]::FLOATVECTOR(4))
LIMIT 1;
----
21

# =============================================================================
# Global search across all partitions (no filter)
# =============================================================================

# Global: closest to [1,0,0,0] -> id=1 (books)
query II
SELECT id, category FROM items
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
1	books

# Global: closest to [0,0,0,1] -> id=13 (games)
query II
SELECT id, category FROM items
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4))
LIMIT 1;
----
13	games

# Global: closest to [0.5,0.5,0,0] -> id=17 or id=20 (sports, exact match)
query I
SELECT category FROM items
ORDER BY l2_distance(vec, [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
sports

# Global top-3 closest to [0,0,0.5,0.5] should pull from travel
query I
SELECT category FROM items
ORDER BY l2_distance(vec, [0.0, 0.0, 0.5, 0.5]::FLOATVECTOR(4))
LIMIT 3;
----
travel
travel
travel

# =============================================================================
# Delete rows from one partition and re-search
# =============================================================================

# Delete all games items
statement ok
DELETE FROM items WHERE category = 'games';

# Verify games partition is empty
query I
SELECT COUNT(*) FROM items WHERE category = 'games';
----
0

# Total row count should be 20
query I
SELECT COUNT(*) FROM items;
----
20

# Global search for [0,0,0,1] should no longer return games
# Closest remaining: id=22 [0,0.1,0.4,0.5] dist=0.648, id=21 [0,0,0.5,0.5] dist=0.707
query II
SELECT id, category FROM items
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4))
LIMIT 1;
----
22	travel

# Other partitions should be unaffected
query I
SELECT id FROM items
WHERE category = 'books'
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
1

query I
SELECT id FROM items
WHERE category = 'music'
ORDER BY l2_distance(vec, [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
9

# =============================================================================
# Delete a single row from sports and verify
# =============================================================================

statement ok
DELETE FROM items WHERE id = 17;

# sports: closest to [0.5,0.5,0,0] -> now id=20 (same vector as deleted 17)
query I
SELECT id FROM items
WHERE category = 'sports'
ORDER BY l2_distance(vec, [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 1;
----
20

# Insert new items into previously-deleted games partition
statement ok
INSERT INTO items VALUES
  (25, 'games', [0.0, 0.0, 0.0, 0.8]::FLOATVECTOR(4)),
  (26, 'games', [0.0, 0.0, 0.2, 0.8]::FLOATVECTOR(4));

# Search the re-populated games partition
query I
SELECT id FROM items
WHERE category = 'games'
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4))
LIMIT 1;
----
25

# Cleanup
statement ok
DROP TABLE items;
