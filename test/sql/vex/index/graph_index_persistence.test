# name: test/sql/vex/index/graph_index_persistence.test
# description: Test graph index persistence across checkpoints
# group: [vex]

require vex

# Use a persistent database
load __TEST_DIR__/graph_index_persist.db

# Create and populate
statement ok
CREATE TABLE vecs (id INTEGER, vec FLOATVECTOR(4));

statement ok
INSERT INTO vecs SELECT i, [(i * 0.1)::FLOAT, (i * 0.2)::FLOAT, (i * 0.3)::FLOAT, (i * 0.4)::FLOAT]::FLOATVECTOR(4) FROM range(100) t(i);

statement ok
CREATE INDEX idx ON vecs USING GRAPH_INDEX (vec);

# Verify search works before checkpoint
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 1;
----
0

# Force checkpoint
statement ok
CHECKPOINT;

# Restart database
restart

# Verify index still exists after restart
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# Verify data is intact
query I
SELECT count(*) FROM vecs;
----
100
