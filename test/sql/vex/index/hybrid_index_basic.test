# name: test/sql/vex/index/hybrid_index_basic.test
# description: Test hybrid index creation and basic operations
# group: [vex]

require vex

# Create table with vector + scalar partition column
statement ok
CREATE TABLE products (id INTEGER, category VARCHAR, vec FLOATVECTOR(4));

# Insert products in different categories
statement ok
INSERT INTO products VALUES
  (1, 'electronics', [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (2, 'electronics', [0.9, 0.1, 0.0, 0.0]::FLOATVECTOR(4)),
  (3, 'electronics', [0.8, 0.2, 0.0, 0.0]::FLOATVECTOR(4)),
  (4, 'clothing', [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (5, 'clothing', [0.0, 0.9, 0.1, 0.0]::FLOATVECTOR(4)),
  (6, 'clothing', [0.0, 0.8, 0.2, 0.0]::FLOATVECTOR(4)),
  (7, 'food', [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4)),
  (8, 'food', [0.0, 0.0, 0.9, 0.1]::FLOATVECTOR(4)),
  (9, 'food', [0.0, 0.0, 0.8, 0.2]::FLOATVECTOR(4));

# Create hybrid index on (vec, category)
statement ok
CREATE INDEX idx_hybrid ON products USING HYBRID_INDEX (vec, category);

# Verify index exists
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_hybrid';
----
1

# Filtered search within 'electronics' partition
# Query closest to [1,0,0,0] in electronics should return id=1
query II
SELECT id, category FROM products
WHERE category = 'electronics'
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 2;
----
1	electronics
2	electronics

# Filtered search within 'food' partition
query II
SELECT id, category FROM products
WHERE category = 'food'
ORDER BY l2_distance(vec, [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4))
LIMIT 2;
----
7	food
8	food

# Global search (no filter) - find closest to [0,0,0,1]
# Distances: id=9: sqrt(0.64+0.64)=1.13, id=8: sqrt(0.81+0.81)=1.27, id=6: sqrt(0.64+0.04+1)=1.30
query I
SELECT id FROM products
ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4))
LIMIT 3;
----
9
8
6

# IN filter: search across electronics + clothing partitions, food excluded
query II
SELECT id, category FROM products
WHERE category IN ('electronics', 'clothing')
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
LIMIT 5;
----
1	electronics
2	electronics
3	electronics
6	clothing
5	clothing

# Verify food is not in IN-filter results
query I
SELECT count(*) FROM (
  SELECT id, category FROM products
  WHERE category IN ('electronics', 'clothing')
  ORDER BY l2_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4))
  LIMIT 10
) WHERE category = 'food';
----
0

# Cleanup
statement ok
DROP TABLE products;
