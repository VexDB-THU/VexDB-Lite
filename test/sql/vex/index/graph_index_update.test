# name: test/sql/vex/index/graph_index_update.test
# description: Test graph index behavior with UPDATE operations
# group: [vex]

require vex

# ============================================================
# Setup
# ============================================================
statement ok
CREATE TABLE vecs (id INTEGER, label VARCHAR, vec FLOATVECTOR(3));

statement ok
INSERT INTO vecs VALUES
  (1, 'a', [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, 'b', [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, 'c', [0.0, 0.0, 1.0]::FLOATVECTOR(3)),
  (4, 'd', [0.5, 0.5, 0.0]::FLOATVECTOR(3)),
  (5, 'e', [0.0, 0.5, 0.5]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx ON vecs USING GRAPH_INDEX (vec);

# Verify initial nearest neighbor to origin
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
4

# ============================================================
# Test 1: UPDATE vector column value, verify search reflects new value
# ============================================================

# Move id=1 from [1,0,0] to very close to origin
statement ok
UPDATE vecs SET vec = [0.01, 0.01, 0.01]::FLOATVECTOR(3) WHERE id = 1;

# Now id=1 should be nearest to origin
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

# Verify the updated vector value
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.01, 0.01, 0.01]::FLOATVECTOR(3)) LIMIT 1;
----
1

# ============================================================
# Test 2: UPDATE non-vector column, verify search still works
# ============================================================

statement ok
UPDATE vecs SET label = 'updated_b' WHERE id = 2;

# Search should still find id=2 nearest to [0,1,0]
query IT
SELECT id, label FROM vecs ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
2	updated_b

# Verify all rows still searchable
query I
SELECT count(*) FROM (SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 10);
----
5

# ============================================================
# Test 3: UPDATE with WHERE clause on non-vector column
# ============================================================

statement ok
UPDATE vecs SET vec = [0.0, 0.0, 0.0]::FLOATVECTOR(3) WHERE label = 'c';

# id=3 (label='c') should now be at the origin
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
3

# ============================================================
# Test 4: Bulk UPDATE all rows
# ============================================================

# Set all vectors to distinct values along x-axis
statement ok
UPDATE vecs SET vec = [(id * 0.1)::FLOAT, 0.0, 0.0]::FLOATVECTOR(3);

# After bulk update, id=1 has [0.1,0,0], id=2 has [0.2,0,0], etc.
# Nearest to origin should be id=1
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

# Nearest to [0.5,0,0] should be id=5 (vec=[0.5,0,0])
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.5, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
5

# Farthest from origin should be id=5 (vec=[0.5,0,0])
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) DESC LIMIT 1;
----
5

# All rows should still be present
query I
SELECT count(*) FROM vecs;
----
5

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE vecs;
