# name: test/sql/vex/index/graph_index_optimizer_extended.test
# description: Extended optimizer tests - operators, function variants, multi-index selection
# group: [vex]

require vex

# ============================================================
# Setup: Single table with all three metric indexes
# ============================================================
statement ok
CREATE TABLE t_multi (id INTEGER, vec FLOAT[8]);

statement ok
INSERT INTO t_multi SELECT i, list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT,
  sin(i*0.2)::FLOAT, cos(i*0.2)::FLOAT,
  sin(i*0.3)::FLOAT, cos(i*0.3)::FLOAT,
  sin(i*0.4)::FLOAT, cos(i*0.4)::FLOAT
)::FLOAT[8]
FROM range(1, 30001) t(i);

statement ok
CREATE INDEX idx_l2 ON t_multi USING GRAPH_INDEX (vec) WITH (metric='l2');

statement ok
CREATE INDEX idx_cos ON t_multi USING GRAPH_INDEX (vec) WITH (metric='cosine');

statement ok
CREATE INDEX idx_ip ON t_multi USING GRAPH_INDEX (vec) WITH (metric='ip');

# ============================================================
# Test 1: <-> operator should use L2 index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY vec <-> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 2: <=> operator should use cosine index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY vec <=> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 3: <~> operator (negative IP) should use IP index with ASC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY vec <~> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 4: inner_product function should use IP index with DESC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) DESC LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 5: list_inner_product should use IP index with DESC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY list_inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) DESC LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 6: array_inner_product should use IP index with DESC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY array_inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) DESC LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 7: array_distance should use L2 index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY array_distance(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 8: array_cosine_distance should use cosine index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY array_cosine_distance(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 9: array_negative_inner_product should use IP index with ASC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY array_negative_inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 10: list_negative_inner_product should use IP index with ASC
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY list_negative_inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) LIMIT 10;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 11: IP with wrong order (ASC) should NOT use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) ASC LIMIT 10;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 12: Negative IP with wrong order (DESC) should NOT use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_multi ORDER BY vec <~> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] DESC LIMIT 10;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 13: Result correctness - L2
# ============================================================
query I
SELECT COUNT(*) FROM (SELECT id FROM t_multi ORDER BY vec <-> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10);
----
10

# ============================================================
# Test 14: Result correctness - Cosine
# ============================================================
query I
SELECT COUNT(*) FROM (SELECT id FROM t_multi ORDER BY vec <=> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10);
----
10

# ============================================================
# Test 15: Result correctness - IP (DESC for positive inner product)
# ============================================================
query I
SELECT COUNT(*) FROM (SELECT id FROM t_multi ORDER BY inner_product(vec, [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8]) DESC LIMIT 10);
----
10

# ============================================================
# Test 16: Result correctness - Negative IP (ASC)
# ============================================================
query I
SELECT COUNT(*) FROM (SELECT id FROM t_multi ORDER BY vec <~> [0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5]::FLOAT[8] LIMIT 10);
----
10

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_multi;
