# name: test/sql/vex/index/graph_index_optimizer_explain.test
# description: Verify optimizer replaces plan with COLUMN_DATA_GET for all distance metrics and patterns
# group: [vex]

require vex

# ============================================================
# Setup: L2 metric (default)
# ============================================================
statement ok
CREATE TABLE t_l2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_l2 VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.5, 0.5, 0.0]),
  (5, [0.0, 0.5, 0.5]),
  (6, [0.5, 0.0, 0.5]),
  (7, [0.3, 0.3, 0.3]),
  (8, [0.9, 0.1, 0.0]),
  (9, [0.1, 0.9, 0.0]),
  (10, [0.0, 0.1, 0.9]);

statement ok
CREATE INDEX idx_l2 ON t_l2 USING GRAPH_INDEX (vec);

# ============================================================
# Test 1: L2 EXPLAIN should show COLUMN_DATA_GET (not SCAN)
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 2: L2 result correctness
# ============================================================
query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
1
8
4

# ============================================================
# Test 3: list_distance (alias for l2) should also trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY list_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 4: <-> operator should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_l2 ORDER BY vec <-> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Setup: Cosine metric
# ============================================================
statement ok
CREATE TABLE t_cos (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_cos VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.7, 0.7, 0.0]),
  (5, [0.0, 0.7, 0.7]),
  (6, [0.7, 0.0, 0.7]),
  (7, [0.5, 0.5, 0.5]),
  (8, [0.95, 0.05, 0.0]),
  (9, [0.05, 0.95, 0.0]),
  (10, [0.0, 0.05, 0.95]);

statement ok
CREATE INDEX idx_cos ON t_cos USING GRAPH_INDEX (vec) WITH (metric='cosine');

# ============================================================
# Test 5: Cosine EXPLAIN should show COLUMN_DATA_GET
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 6: Cosine result correctness
# ============================================================
query I
SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
1
8
4

# ============================================================
# Test 7: list_cosine_distance should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY list_cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 8: <=> operator should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY vec <=> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 9: Metric mismatch - l2 query on cosine index should NOT use index
# ============================================================
query II
EXPLAIN SELECT id FROM t_cos ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Setup: Inner Product metric
# ============================================================
statement ok
CREATE TABLE t_ip (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_ip VALUES
  (1, [1.0, 0.0, 0.0]),
  (2, [0.0, 1.0, 0.0]),
  (3, [0.0, 0.0, 1.0]),
  (4, [0.7, 0.7, 0.0]),
  (5, [0.0, 0.7, 0.7]),
  (6, [0.7, 0.0, 0.7]),
  (7, [0.5, 0.5, 0.5]),
  (8, [0.9, 0.1, 0.0]),
  (9, [0.1, 0.9, 0.0]),
  (10, [0.0, 0.1, 0.9]);

statement ok
CREATE INDEX idx_ip ON t_ip USING GRAPH_INDEX (vec) WITH (metric='ip');

# ============================================================
# Test 10: IP with DESC should trigger optimizer
# ============================================================
query II
EXPLAIN SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) DESC LIMIT 3;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

# ============================================================
# Test 11: IP result correctness (DESC = highest similarity first)
# ============================================================
query I
SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) DESC LIMIT 3;
----
1
8
4

# ============================================================
# Test 12: IP with ASC should NOT trigger optimizer (wrong order)
# ============================================================
query II
EXPLAIN SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) ASC LIMIT 3;
----
physical_plan	<REGEX>:.*SEQ_SCAN.*

# ============================================================
# Test 13: FLOATVECTOR type alias should work
# ============================================================
statement ok
CREATE TABLE t_alias (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_alias VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]), (2, [0.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_alias ON t_alias USING GRAPH_INDEX (vec);

query II
EXPLAIN SELECT id FROM t_alias ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query I
SELECT id FROM t_alias ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

# ============================================================
# Test 14: Prepared statement (parameter binding)
# Optimizer cannot trigger for prepared stmts (parameter not constant at optimize time)
# but the query should still produce correct results via full scan
# ============================================================
statement ok
PREPARE ann_query AS SELECT id FROM t_l2 ORDER BY l2_distance(vec, $1::FLOAT[3]) LIMIT 3;

query I
EXECUTE ann_query([1.0, 0.0, 0.0]);
----
1
8
6

statement ok
DEALLOCATE ann_query;

# ============================================================
# Test 15: LIMIT with OFFSET
# ============================================================
query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2 OFFSET 1;
----
8
4

# ============================================================
# Test 16: SELECT * (all columns) with optimizer
# ============================================================
query II
EXPLAIN SELECT * FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query I
SELECT id FROM (SELECT * FROM t_l2 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2);
----
1
8

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_l2;

statement ok
DROP TABLE t_cos;

statement ok
DROP TABLE t_ip;

statement ok
DROP TABLE t_alias;
