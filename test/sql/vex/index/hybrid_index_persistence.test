# name: test/sql/vex/index/hybrid_index_persistence.test
# description: Test hybrid index persistence across checkpoints
# group: [vex]

require vex

load __TEST_DIR__/hybrid_index_persist.db

statement ok
CREATE TABLE items (id INTEGER, category VARCHAR, vec FLOATVECTOR(3));

statement ok
INSERT INTO items VALUES
  (1, 'A', [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, 'A', [0.9, 0.1, 0.0]::FLOATVECTOR(3)),
  (3, 'B', [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (4, 'B', [0.0, 0.9, 0.1]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx ON items USING HYBRID_INDEX (vec, category);

# Verify filtered search works
query I
SELECT id FROM items WHERE category = 'A' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

statement ok
CHECKPOINT;

restart

# Verify after restart
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

query I
SELECT count(*) FROM items;
----
4
