# name: test/sql/vex/index/hybrid_index_transaction.test
# description: Test hybrid index transaction semantics (INSERT, DELETE, COMMIT, ROLLBACK)
# group: [vex]

require vex

# ============================================================
# Test 1: Auto-commit INSERT + search
# ============================================================
statement ok
CREATE TABLE h1 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h1 ON h1 USING HYBRID_INDEX (vec, category);

statement ok
INSERT INTO h1 VALUES (4, [0.99, 0.01, 0.0]::FLOAT[3], 'A');

query I
SELECT id FROM h1 WHERE category = 'A' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

query I
SELECT count(*) FROM h1;
----
4

statement ok
DROP TABLE h1;

# ============================================================
# Test 2: Auto-commit DELETE + search
# ============================================================
statement ok
CREATE TABLE h2 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h2 ON h2 USING HYBRID_INDEX (vec, category);

statement ok
DELETE FROM h2 WHERE id = 1;

query I
SELECT count(*) FROM h2;
----
2

query I
SELECT count(*) FROM h2 WHERE id = 1;
----
0

statement ok
DROP TABLE h2;

# ============================================================
# Test 3: BEGIN + INSERT + COMMIT
# ============================================================
statement ok
CREATE TABLE h3 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h3 ON h3 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
INSERT INTO h3 VALUES (3, [0.5, 0.5, 0.0]::FLOAT[3], 'A');

statement ok
COMMIT;

query I
SELECT count(*) FROM h3;
----
3

query I
SELECT count(*) FROM h3 WHERE id = 3;
----
1

statement ok
DROP TABLE h3;

# ============================================================
# Test 4: BEGIN + DELETE + COMMIT
# ============================================================
statement ok
CREATE TABLE h4 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h4 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h4 ON h4 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
DELETE FROM h4 WHERE id = 1;

statement ok
COMMIT;

query I
SELECT count(*) FROM h4;
----
2

query I
SELECT count(*) FROM h4 WHERE id = 1;
----
0

statement ok
DROP TABLE h4;

# ============================================================
# Test 5: BEGIN + INSERT + ROLLBACK
# ============================================================
statement ok
CREATE TABLE h5 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h5 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h5 ON h5 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
INSERT INTO h5 VALUES (3, [0.5, 0.5, 0.0]::FLOAT[3], 'A');

statement ok
INSERT INTO h5 VALUES (4, [0.0, 0.5, 0.5]::FLOAT[3], 'B');

statement ok
ROLLBACK;

# After rollback: only 2 rows
query I
SELECT count(*) FROM h5;
----
2

query I
SELECT count(*) FROM h5 WHERE id = 3;
----
0

query I
SELECT count(*) FROM h5 WHERE id = 4;
----
0

statement ok
DROP TABLE h5;

# ============================================================
# Test 6: BEGIN + DELETE + ROLLBACK
# ============================================================
statement ok
CREATE TABLE h6 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h6 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h6 ON h6 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
DELETE FROM h6 WHERE id = 1;

query I
SELECT count(*) FROM h6;
----
2

statement ok
ROLLBACK;

# After rollback: all 3 rows visible
query I
SELECT count(*) FROM h6;
----
3

query I
SELECT count(*) FROM h6 WHERE id = 1;
----
1

statement ok
DROP TABLE h6;

# ============================================================
# Test 7: BEGIN + INSERT + DELETE + ROLLBACK (mixed ops)
# ============================================================
statement ok
CREATE TABLE h7 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h7 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'A'),
  (3, [0.0, 0.0, 1.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h7 ON h7 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
INSERT INTO h7 VALUES (4, [0.5, 0.5, 0.0]::FLOAT[3], 'A');

statement ok
DELETE FROM h7 WHERE id = 2;

statement ok
ROLLBACK;

# After rollback: original 3 rows
query I
SELECT count(*) FROM h7;
----
3

query I
SELECT count(*) FROM h7 WHERE id = 2;
----
1

query I
SELECT count(*) FROM h7 WHERE id = 4;
----
0

statement ok
DROP TABLE h7;

# ============================================================
# Test 8: CREATE INDEX inside transaction + ROLLBACK
# ============================================================
statement ok
CREATE TABLE h8 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h8 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
BEGIN;

statement ok
CREATE INDEX idx_h8 ON h8 USING HYBRID_INDEX (vec, category);

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_h8';
----
1

statement ok
ROLLBACK;

# Index should not exist after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_h8';
----
0

statement ok
DROP TABLE h8;

# ============================================================
# Test 9: DROP INDEX inside transaction + ROLLBACK
# ============================================================
statement ok
CREATE TABLE h9 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h9 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h9 ON h9 USING HYBRID_INDEX (vec, category);

statement ok
BEGIN;

statement ok
DROP INDEX idx_h9;

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_h9';
----
0

statement ok
ROLLBACK;

# Index should be restored after rollback
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_h9';
----
1

statement ok
DROP TABLE h9;

# ============================================================
# Test 10: Consecutive ROLLBACK then COMMIT
# ============================================================
statement ok
CREATE TABLE h10 (id INTEGER, vec FLOAT[3], category VARCHAR);

statement ok
INSERT INTO h10 VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3], 'A'),
  (2, [0.0, 1.0, 0.0]::FLOAT[3], 'B');

statement ok
CREATE INDEX idx_h10 ON h10 USING HYBRID_INDEX (vec, category);

# First: rollback
statement ok
BEGIN;

statement ok
INSERT INTO h10 VALUES (3, [0.0, 0.0, 1.0]::FLOAT[3], 'A');

statement ok
ROLLBACK;

query I
SELECT count(*) FROM h10;
----
2

# Second: commit
statement ok
BEGIN;

statement ok
INSERT INTO h10 VALUES (4, [0.5, 0.5, 0.5]::FLOAT[3], 'B');

statement ok
COMMIT;

query I
SELECT count(*) FROM h10;
----
3

query I
SELECT count(*) FROM h10 WHERE id = 3;
----
0

query I
SELECT count(*) FROM h10 WHERE id = 4;
----
1

statement ok
DROP TABLE h10;
