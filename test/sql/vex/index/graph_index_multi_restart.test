# name: test/sql/vex/index/graph_index_multi_restart.test
# description: Test multiple indexes on same table with restart
# group: [vex]
#
# Each index has its own row_id_map; verify they are independently serialized/restored.

require vex

load __TEST_DIR__/multi_restart.db

statement ok
CREATE TABLE multi (id INTEGER, vec1 FLOATVECTOR(3), vec2 FLOATVECTOR(4));

statement ok
INSERT INTO multi VALUES
  (1,  [1.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4)),
  (2,  [0.9, 0.1, 0.0]::FLOATVECTOR(3), [0.0, 0.0, 1.0, 0.0]::FLOATVECTOR(4)),
  (3,  [0.0, 1.0, 0.0]::FLOATVECTOR(3), [0.0, 1.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (4,  [0.0, 0.0, 1.0]::FLOATVECTOR(3), [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)),
  (5,  [0.5, 0.5, 0.0]::FLOATVECTOR(3), [0.0, 0.5, 0.5, 0.0]::FLOATVECTOR(4)),
  (6,  [0.0, 0.5, 0.5]::FLOATVECTOR(3), [0.5, 0.0, 0.0, 0.5]::FLOATVECTOR(4)),
  (7,  [0.5, 0.0, 0.5]::FLOATVECTOR(3), [0.5, 0.5, 0.0, 0.0]::FLOATVECTOR(4)),
  (8,  [0.3, 0.3, 0.3]::FLOATVECTOR(3), [0.25, 0.25, 0.25, 0.25]::FLOATVECTOR(4));

statement ok
CREATE INDEX idx_v1 ON multi USING GRAPH_INDEX (vec1);

statement ok
CREATE INDEX idx_v2 ON multi USING GRAPH_INDEX (vec2);

statement ok
CHECKPOINT;

restart

# Trigger binding for both indexes
statement ok
DELETE FROM multi WHERE id = -999;

# Both indexes should have consistent state
query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v1';
----
true

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v2';
----
true

# Search on vec1: nearest to [1,0,0] should be id=1
query I
SELECT id FROM multi ORDER BY l2_distance(vec1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

# Search on vec2: nearest to [1,0,0,0] should be id=4
query I
SELECT id FROM multi ORDER BY l2_distance(vec2, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 1;
----
4

# DELETE a row — both indexes should update
statement ok
DELETE FROM multi WHERE id = 1;

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v1';
----
true

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v2';
----
true

# Nearest to [1,0,0] in vec1 should now be id=2 (vec1=[0.9,0.1,0])
query I
SELECT id FROM multi ORDER BY l2_distance(vec1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
2

# Nearest to [0,0,0,1] in vec2 should no longer be id=1
query I
SELECT id FROM multi ORDER BY l2_distance(vec2, [0.0, 0.0, 0.0, 1.0]::FLOATVECTOR(4)) LIMIT 1;
----
6

# Persist and verify second restart
statement ok
CHECKPOINT;

restart

statement ok
DELETE FROM multi WHERE id = -999;

query I
SELECT count(*) FROM multi;
----
7

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v1';
----
true

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_v2';
----
true

# Both searches still correct after second restart
query I
SELECT id FROM multi ORDER BY l2_distance(vec1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
2

query I
SELECT id FROM multi ORDER BY l2_distance(vec2, [1.0, 0.0, 0.0, 0.0]::FLOATVECTOR(4)) LIMIT 1;
----
4

statement ok
DROP TABLE multi;
