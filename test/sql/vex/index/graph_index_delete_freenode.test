# name: test/sql/vex/index/graph_index_delete_freenode.test
# description: Verify synchronous FreeNode in Delete - node_count correctness and allocator segment reclamation
# group: [vex]

require vex

# ============================================================
# Test 1: Delete down to 1 node — node_count must not double-decrement to 0
# (node_count==0 would cause Search to return empty)
# ============================================================

statement ok
CREATE TABLE t1 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx1 ON t1 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t1 WHERE id = 1;

# If node_count was double-decremented to 0, this would return 0 rows
query I
SELECT count(*) FROM (SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOATVECTOR(3)) LIMIT 1);
----
1

query I
SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
2

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: Delete all but one from a larger set
# ============================================================

statement ok
CREATE TABLE t2 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3)),
  (4, [0.5, 0.5, 0.0]::FLOATVECTOR(3)),
  (5, [0.0, 0.5, 0.5]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx2 ON t2 USING GRAPH_INDEX (vec);

# Delete 4 of 5 nodes
statement ok
DELETE FROM t2 WHERE id IN (1, 2, 3, 4);

# Must still find the remaining node
query I
SELECT id FROM t2 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
5

# Insert after heavy delete — allocator should reuse freed segments
statement ok
INSERT INTO t2 VALUES (6, [0.1, 0.1, 0.1]::FLOATVECTOR(3));

query I
SELECT count(*) FROM (SELECT id FROM t2 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 2);
----
2

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: Delete all nodes — search should return empty, not crash
# ============================================================

statement ok
CREATE TABLE t3 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx3 ON t3 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t3;

query I
SELECT count(*) FROM (SELECT id FROM t3 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 5);
----
0

# Insert after deleting all — fresh start on same allocator
statement ok
INSERT INTO t3 VALUES (3, [0.5, 0.5, 0.5]::FLOATVECTOR(3));

query I
SELECT id FROM t3 ORDER BY l2_distance(vec, [0.5, 0.5, 0.5]::FLOATVECTOR(3)) LIMIT 1;
----
3

statement ok
DROP TABLE t3;

# ============================================================
# Test 4: HybridIndex — delete single node from 2-node partition
# ============================================================

statement ok
CREATE TABLE t4 (id INTEGER, cat VARCHAR, vec FLOATVECTOR(3));

statement ok
INSERT INTO t4 VALUES
  (1, 'a', [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, 'a', [0.9, 0.1, 0.0]::FLOATVECTOR(3)),
  (3, 'b', [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx4 ON t4 USING HYBRID_INDEX (vec, cat);

statement ok
DELETE FROM t4 WHERE id = 1;

# Must still find id=2 in partition 'a'
query I
SELECT id FROM t4 WHERE cat = 'a' ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
2

# Partition 'b' unaffected
query I
SELECT id FROM t4 WHERE cat = 'b' ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
3

statement ok
DROP TABLE t4;

# ============================================================
# Test 5: HybridIndex — delete entire partition, then insert
# ============================================================

statement ok
CREATE TABLE t5 (id INTEGER, cat VARCHAR, vec FLOATVECTOR(3));

statement ok
INSERT INTO t5 VALUES
  (1, 'x', [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, 'x', [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, 'y', [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx5 ON t5 USING HYBRID_INDEX (vec, cat);

statement ok
DELETE FROM t5 WHERE cat = 'x';

query I
SELECT count(*) FROM t5 WHERE cat = 'x';
----
0

# Insert into same partition after full delete
statement ok
INSERT INTO t5 VALUES (4, 'x', [0.5, 0.5, 0.0]::FLOATVECTOR(3));

query I
SELECT id FROM t5 WHERE cat = 'x' ORDER BY l2_distance(vec, [0.5, 0.5, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
4

statement ok
DROP TABLE t5;

# ============================================================
# Test 6: Checkpoint + restart after FreeNode delete
# ============================================================

load __TEST_DIR__/freenode_persist.db

statement ok
CREATE TABLE t6 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t6 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx6 ON t6 USING GRAPH_INDEX (vec);

statement ok
DELETE FROM t6 WHERE id = 1;

statement ok
CHECKPOINT;

restart

# After restart, freed node should not reappear
query I
SELECT count(*) FROM t6;
----
2

query I
SELECT count(*) FROM (SELECT id FROM t6 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 2);
----
2

# Insert should work on restarted allocator
statement ok
INSERT INTO t6 VALUES (4, [0.5, 0.5, 0.5]::FLOATVECTOR(3));

query I
SELECT count(*) FROM (SELECT id FROM t6 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 3);
----
3

statement ok
DROP TABLE t6;
