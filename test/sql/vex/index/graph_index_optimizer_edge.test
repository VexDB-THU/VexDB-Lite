# name: test/sql/vex/index/graph_index_optimizer_edge.test
# description: Test optimizer edge cases that should NOT use index
# group: [vex]

require vex

# ============================================================
# Setup
# ============================================================
statement ok
CREATE TABLE t_opt (id INTEGER, val FLOAT, vec FLOATVECTOR(3));

statement ok
CREATE INDEX idx_opt ON t_opt USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t_opt VALUES
  (1, 10.0, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, 20.0, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, 30.0, [0.0, 0.0, 1.0]::FLOATVECTOR(3)),
  (4, 40.0, [0.5, 0.5, 0.0]::FLOATVECTOR(3)),
  (5, 50.0, [0.0, 0.5, 0.5]::FLOATVECTOR(3));

# ============================================================
# Test 1: ORDER BY non-distance column (should NOT use index)
# ============================================================
query I
SELECT id FROM t_opt ORDER BY val LIMIT 2;
----
1
2

# ============================================================
# Test 2: ORDER BY distance DESC (farthest first - should work via scan)
# ============================================================
query I
SELECT id FROM t_opt ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) DESC LIMIT 2;
----
2
3

# ============================================================
# Test 3: No LIMIT clause (full sort, should not use index)
# ============================================================
query I
SELECT id FROM t_opt ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3));
----
1
4
5
2
3

# ============================================================
# Test 4: Multiple ORDER BY columns
# ============================================================
query I
SELECT id FROM t_opt ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOATVECTOR(3)), id LIMIT 3;
----
4
5
1

# ============================================================
# Test 5: OFFSET without LIMIT
# ============================================================
query I
SELECT id FROM t_opt ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 2 OFFSET 1;
----
4
5

# ============================================================
# Test 6: Large OFFSET exceeding result count
# ============================================================
query I
SELECT count(*) FROM (SELECT id FROM t_opt ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 3 OFFSET 100);
----
0

# ============================================================
# Test 7: distance between two columns (no constant vector)
# ============================================================
statement ok
CREATE TABLE t_two (id INTEGER, v1 FLOATVECTOR(3), v2 FLOATVECTOR(3));

statement ok
INSERT INTO t_two VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3), [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.5, 0.5, 0.0]::FLOATVECTOR(3), [0.5, 0.5, 0.0]::FLOATVECTOR(3));

# This should NOT use index (two column refs, no constant)
query I
SELECT id FROM t_two ORDER BY l2_distance(v1, v2) LIMIT 1;
----
2

statement ok
DROP TABLE t_two;

# ============================================================
# Test 8: JOIN with ORDER BY distance
# ============================================================
statement ok
CREATE TABLE t_meta (id INTEGER, label VARCHAR);

statement ok
INSERT INTO t_meta VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

# JOIN + ORDER BY distance — optimizer should handle gracefully
query IT
SELECT t_opt.id, t_meta.label
FROM t_opt JOIN t_meta ON t_opt.id = t_meta.id
ORDER BY l2_distance(t_opt.vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3))
LIMIT 2;
----
1	a
4	d

statement ok
DROP TABLE t_meta;

# ============================================================
# Cleanup
# ============================================================
statement ok
DROP TABLE t_opt;
