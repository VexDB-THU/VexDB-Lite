statement ok
CREATE INDEX idx_hybrid_ip ON t_hybrid_ip USING HYBRID_INDEX (vec, cat) WITH (metric='ip');

statement ok
INSERT INTO t_hybrid_ip SELECT i, 'x', list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT, 0.0, 0.0
)::FLOAT[4]
FROM range(1, 51) t(i);

query I
