true

query I
SELECT count(*) FROM (
  SELECT id FROM t_hybrid_ip
  WHERE cat = 'x'
  ORDER BY inner_product(vec, [1.0, 0.0, 0.0, 0.0]::FLOAT[4]) DESC
  LIMIT 5
);
----
5

statement ok
DROP TABLE t_hybrid_ip;

