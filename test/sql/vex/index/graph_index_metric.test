# name: test/sql/vex/index/graph_index_metric.test
# description: Test distance metric support (L2, cosine, inner_product) for GraphIndex
# group: [vex]
#
# Verifies:
# - WITH (metric='cosine') / WITH (metric='ip') creation
# - Correct distance function selection and result ordering
# - Metric persistence across restart
# - Optimizer metric compatibility check (cosine index only serves cosine queries)

require vex

# ============================================================
# Test 1: Cosine metric — basic creation and search
# ============================================================

statement ok
CREATE TABLE t_cos (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_cos VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]),
  (4, [0.577, 0.577, 0.577]::FLOAT[3]),
  (5, [0.707, 0.707, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_cos ON t_cos USING GRAPH_INDEX (vec) WITH (metric='cosine');

# Closest to [1,0,0] should be id=1
query I
SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

# Top-3
query I
SELECT id FROM t_cos ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 3;
----
1
5
4

# <=> operator also works with cosine index
query I
SELECT id FROM t_cos ORDER BY vec <=> [0.0, 0.0, 1.0]::FLOAT[3] LIMIT 1;
----
3

statement ok
DROP TABLE t_cos;

# ============================================================
# Test 2: Cosine metric with non-normalized vectors
# This is the key difference: cosine index normalizes internally
# ============================================================

statement ok
CREATE TABLE t_cos_nn (id INTEGER, vec FLOAT[3]);

# Non-normalized vectors — magnitudes vary widely
statement ok
INSERT INTO t_cos_nn VALUES
  (1, [10.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 0.001, 0.0]::FLOAT[3]),
  (3, [5.0, 5.0, 0.0]::FLOAT[3]),
  (4, [100.0, 1.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_cos_nn ON t_cos_nn USING GRAPH_INDEX (vec) WITH (metric='cosine');

# Query [1,0,0] — id=1 (exact direction), id=4 (nearly same direction) should be top-2
# Despite id=2 being tiny magnitude, cosine only cares about direction
query I
SELECT id FROM t_cos_nn ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
1
4

statement ok
DROP TABLE t_cos_nn;

# ============================================================
# Test 3: Inner product metric — creation and search
# ============================================================

statement ok
CREATE TABLE t_ip (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_ip VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.5, 0.5, 0.0]::FLOAT[3]),
  (4, [10.0, 0.0, 0.0]::FLOAT[3]),
  (5, [-1.0, 0.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_ip ON t_ip USING GRAPH_INDEX (vec) WITH (metric='ip');

# inner_product DESC: highest IP first
# Query [1,0,0]: id=4 (ip=10), id=1 (ip=1), id=3 (ip=0.5), id=2 (ip=0), id=5 (ip=-1)
query I
SELECT id FROM t_ip ORDER BY inner_product(vec, [1.0, 0.0, 0.0]::FLOAT[3]) DESC LIMIT 3;
----
4
1
3

statement ok
DROP TABLE t_ip;

# ============================================================
# Test 4: L2 metric (explicit) — default behavior unchanged
# ============================================================

statement ok
CREATE TABLE t_l2 (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_l2 VALUES
  (1, [0.0, 0.0, 0.0]::FLOAT[3]),
  (2, [1.0, 0.0, 0.0]::FLOAT[3]),
  (3, [10.0, 0.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_l2 ON t_l2 USING GRAPH_INDEX (vec) WITH (metric='l2');

query I
SELECT id FROM t_l2 ORDER BY l2_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) LIMIT 2;
----
1
2

statement ok
DROP TABLE t_l2;

# ============================================================
# Test 5: Metric mismatch — optimizer should NOT use index
# When index is cosine but query uses l2_distance, fall back to brute force
# ============================================================

statement ok
CREATE TABLE t_mismatch (id INTEGER, vec FLOAT[3]);

statement ok
INSERT INTO t_mismatch VALUES
  (1, [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, [0.0, 1.0, 0.0]::FLOAT[3]),
  (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
CREATE INDEX idx_mismatch ON t_mismatch USING GRAPH_INDEX (vec) WITH (metric='cosine');

# l2_distance query on a cosine index — should still work (brute force), just not optimized
query I
SELECT id FROM t_mismatch ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 1;
----
1

statement ok
DROP TABLE t_mismatch;

# ============================================================
# Test 6: Cosine metric with larger dataset + invariant check
# ============================================================

statement ok
CREATE TABLE t_cos_large (id INTEGER, vec FLOAT[8]);

statement ok
INSERT INTO t_cos_large SELECT i, list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT,
  sin(i*0.2)::FLOAT, cos(i*0.2)::FLOAT,
  sin(i*0.3)::FLOAT, cos(i*0.3)::FLOAT,
  sin(i*0.4)::FLOAT, cos(i*0.4)::FLOAT
)::FLOAT[8]
FROM range(1, 201) t(i);

statement ok
CREATE INDEX idx_cos_large ON t_cos_large USING GRAPH_INDEX (vec) WITH (metric='cosine');

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_cos_large';
----
true

# Search works
query I
SELECT count(*) FROM (
  SELECT id FROM t_cos_large
  ORDER BY cosine_distance(vec, [1.0,0.0,1.0,0.0,1.0,0.0,1.0,0.0]::FLOAT[8])
  LIMIT 10
);
----
10

# INSERT more
statement ok
INSERT INTO t_cos_large SELECT i, list_value(
  cos(i*0.1)::FLOAT, sin(i*0.1)::FLOAT,
  cos(i*0.2)::FLOAT, sin(i*0.2)::FLOAT,
  cos(i*0.3)::FLOAT, sin(i*0.3)::FLOAT,
  cos(i*0.4)::FLOAT, sin(i*0.4)::FLOAT
)::FLOAT[8]
FROM range(201, 301) t(i);

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_cos_large';
----
true

# DELETE
statement ok
DELETE FROM t_cos_large WHERE id <= 50;

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_cos_large';
----
true

statement ok
DROP TABLE t_cos_large;

# ============================================================
# Test 7: IP metric with larger dataset
# ============================================================

statement ok
CREATE TABLE t_ip_large (id INTEGER, vec FLOAT[4]);

statement ok
INSERT INTO t_ip_large SELECT i, list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT,
  sin(i*0.2)::FLOAT, cos(i*0.2)::FLOAT
)::FLOAT[4]
FROM range(1, 201) t(i);

statement ok
CREATE INDEX idx_ip_large ON t_ip_large USING GRAPH_INDEX (vec) WITH (metric='ip');

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_ip_large';
----
true

query I
SELECT count(*) FROM (
  SELECT id FROM t_ip_large
  ORDER BY inner_product(vec, [1.0, 0.0, 1.0, 0.0]::FLOAT[4]) DESC
  LIMIT 10
);
----
10

statement ok
DROP TABLE t_ip_large;

# ============================================================
# Test 8: Metric persistence across restart
# ============================================================

load __TEST_DIR__/metric_restart.db

statement ok
CREATE TABLE t_restart (id INTEGER, vec FLOAT[4]);

statement ok
INSERT INTO t_restart SELECT i, list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT,
  sin(i*0.2)::FLOAT, cos(i*0.2)::FLOAT
)::FLOAT[4]
FROM range(1, 101) t(i);

statement ok
CREATE INDEX idx_restart_cos ON t_restart USING GRAPH_INDEX (vec) WITH (metric='cosine');

statement ok
CHECKPOINT;

restart

# Cosine search should still work after restart
query I
SELECT count(*) FROM (
  SELECT id FROM t_restart
  ORDER BY cosine_distance(vec, [0.5, 0.5, 0.5, 0.5]::FLOAT[4])
  LIMIT 10
);
----
10

# INSERT after restart — vectors should be normalized by restored metric
statement ok
INSERT INTO t_restart SELECT i, list_value(
  cos(i*0.1)::FLOAT, sin(i*0.1)::FLOAT,
  cos(i*0.2)::FLOAT, sin(i*0.2)::FLOAT
)::FLOAT[4]
FROM range(101, 151) t(i);

query I
SELECT node_count <= row_id_map_size FROM vex_index_info() WHERE index_name = 'idx_restart_cos';
----
true

query I
SELECT count(*) FROM (
  SELECT id FROM t_restart
  ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOAT[4])
  LIMIT 15
);
----
15

statement ok
DROP TABLE t_restart;

# ============================================================
# Test 9: HybridIndex with cosine metric
# ============================================================

statement ok
CREATE TABLE t_hybrid_cos (id INTEGER, cat VARCHAR, vec FLOAT[4]);

statement ok
CREATE INDEX idx_hybrid_cos ON t_hybrid_cos USING HYBRID_INDEX (vec, cat) WITH (metric='cosine');

statement ok
INSERT INTO t_hybrid_cos SELECT i, 'a', list_value(
  sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT, 0.0, 0.0
)::FLOAT[4]
FROM range(1, 51) t(i);

statement ok
INSERT INTO t_hybrid_cos SELECT i, 'b', list_value(
  0.0, 0.0, sin(i*0.1)::FLOAT, cos(i*0.1)::FLOAT
)::FLOAT[4]
FROM range(51, 101) t(i);

query I
SELECT bool_and(node_count <= row_id_map_size) FROM vex_index_info() WHERE index_name = 'idx_hybrid_cos';
----
true

query I
SELECT count(*) FROM (
  SELECT id FROM t_hybrid_cos
  WHERE cat = 'a'
  ORDER BY cosine_distance(vec, [1.0, 0.0, 0.0, 0.0]::FLOAT[4])
  LIMIT 5
);
----
5

statement ok
DROP TABLE t_hybrid_cos;

