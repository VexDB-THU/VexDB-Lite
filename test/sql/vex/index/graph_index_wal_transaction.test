# name: test/sql/vex/index/graph_index_wal_transaction.test
# description: Test WAL recovery combined with transaction semantics
# group: [vex]

require vex

# ============================================================
# Test 1: COMMIT + WAL restart (no checkpoint)
# ============================================================
load __TEST_DIR__/wal_txn_1.db

statement ok
CREATE TABLE t1 (id INTEGER, vec FLOATVECTOR(3));

statement ok
CREATE INDEX idx1 ON t1 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t1 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
BEGIN;

statement ok
INSERT INTO t1 VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
COMMIT;

# WAL restart (no checkpoint)
restart

query I
SELECT count(*) FROM t1;
----
3

query I
SELECT id FROM t1 ORDER BY l2_distance(vec, [0.0, 0.0, 1.0]::FLOATVECTOR(3)) LIMIT 1;
----
3

statement ok
DROP TABLE t1;

# ============================================================
# Test 2: ROLLBACK + COMMIT + WAL restart
# ============================================================
load __TEST_DIR__/wal_txn_2.db

statement ok
CREATE TABLE t2 (id INTEGER, vec FLOATVECTOR(3));

statement ok
CREATE INDEX idx2 ON t2 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t2 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

# Rollback an insert
statement ok
BEGIN;

statement ok
INSERT INTO t2 VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
ROLLBACK;

# Commit a different insert
statement ok
BEGIN;

statement ok
INSERT INTO t2 VALUES (4, [0.5, 0.5, 0.0]::FLOATVECTOR(3));

statement ok
COMMIT;

# WAL restart
restart

# Should have 3 rows (original 2 + committed id=4), not id=3
query I
SELECT count(*) FROM t2;
----
3

query I
SELECT count(*) FROM t2 WHERE id = 3;
----
0

query I
SELECT count(*) FROM t2 WHERE id = 4;
----
1

query I
SELECT id FROM t2 ORDER BY l2_distance(vec, [0.5, 0.5, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
4

statement ok
DROP TABLE t2;

# ============================================================
# Test 3: DELETE + COMMIT + WAL restart
# ============================================================
load __TEST_DIR__/wal_txn_3.db

statement ok
CREATE TABLE t3 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t3 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx3 ON t3 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t3 WHERE id = 2;

statement ok
COMMIT;

# WAL restart
restart

query I
SELECT count(*) FROM t3;
----
2

query I
SELECT count(*) FROM t3 WHERE id = 2;
----
0

query I
SELECT count(*) FROM (SELECT id FROM t3 ORDER BY l2_distance(vec, [0.0, 1.0, 0.0]::FLOATVECTOR(3)) LIMIT 2);
----
2

statement ok
DROP TABLE t3;

# ============================================================
# Test 4: DELETE ROLLBACK + WAL restart (deleted data preserved)
# ============================================================
load __TEST_DIR__/wal_txn_4.db

statement ok
CREATE TABLE t4 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t4 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3)),
  (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx4 ON t4 USING GRAPH_INDEX (vec);

statement ok
BEGIN;

statement ok
DELETE FROM t4 WHERE id = 1;

statement ok
ROLLBACK;

# WAL restart
restart

# id=1 should still exist after rollback + WAL recovery
query I
SELECT count(*) FROM t4;
----
3

query I
SELECT count(*) FROM t4 WHERE id = 1;
----
1

statement ok
DROP TABLE t4;

# ============================================================
# Test 5: Checkpoint + more ops + WAL restart
# ============================================================
load __TEST_DIR__/wal_txn_5.db

statement ok
CREATE TABLE t5 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t5 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
CREATE INDEX idx5 ON t5 USING GRAPH_INDEX (vec);

# Checkpoint saves state to disk
statement ok
CHECKPOINT;

# More operations after checkpoint (go to WAL)
statement ok
INSERT INTO t5 VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

statement ok
DELETE FROM t5 WHERE id = 1;

# WAL restart (checkpoint + WAL replay)
restart

query I
SELECT count(*) FROM t5;
----
2

query I
SELECT count(*) FROM t5 WHERE id = 1;
----
0

query I
SELECT count(*) FROM t5 WHERE id = 3;
----
1

query I
SELECT id FROM t5 ORDER BY l2_distance(vec, [0.0, 0.0, 1.0]::FLOATVECTOR(3)) LIMIT 1;
----
3

statement ok
DROP TABLE t5;

# ============================================================
# Test 6: Multiple restarts without checkpoint
# ============================================================
load __TEST_DIR__/wal_txn_6.db

statement ok
CREATE TABLE t6 (id INTEGER, vec FLOATVECTOR(3));

statement ok
CREATE INDEX idx6 ON t6 USING GRAPH_INDEX (vec);

statement ok
INSERT INTO t6 VALUES (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3));

restart

statement ok
INSERT INTO t6 VALUES (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

restart

statement ok
INSERT INTO t6 VALUES (3, [0.0, 0.0, 1.0]::FLOATVECTOR(3));

restart

query I
SELECT count(*) FROM t6;
----
3

query I
SELECT id FROM t6 ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOATVECTOR(3)) LIMIT 1;
----
1

statement ok
DROP TABLE t6;

# ============================================================
# Test 7: CREATE INDEX in transaction + ROLLBACK + WAL restart
# ============================================================
load __TEST_DIR__/wal_txn_7.db

statement ok
CREATE TABLE t7 (id INTEGER, vec FLOATVECTOR(3));

statement ok
INSERT INTO t7 VALUES
  (1, [1.0, 0.0, 0.0]::FLOATVECTOR(3)),
  (2, [0.0, 1.0, 0.0]::FLOATVECTOR(3));

statement ok
BEGIN;

statement ok
CREATE INDEX idx7 ON t7 USING GRAPH_INDEX (vec);

statement ok
ROLLBACK;

# WAL restart
restart

# Index should not exist
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx7';
----
0

# Data should still be there
query I
SELECT count(*) FROM t7;
----
2

statement ok
DROP TABLE t7;
