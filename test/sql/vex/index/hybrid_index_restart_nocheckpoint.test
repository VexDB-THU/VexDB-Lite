# name: test/sql/vex/index/hybrid_index_restart_nocheckpoint.test
# description: Test HybridIndex restart WITHOUT explicit checkpoint (WAL replay path)
# group: [vex]
#
# Exercises SerializeToWAL / DeserializeFromStorage for HybridIndex.
# GraphIndex has graph_index_restart_nocheckpoint.test but HybridIndex WAL path was untested.

require vex

# ============================================================
# Test 1: INSERT → restart (no checkpoint) → data intact
# ============================================================

load __TEST_DIR__/hybrid_nocp1.db

statement ok
CREATE TABLE t1 (id INTEGER, cat VARCHAR, vec FLOATVECTOR(4));

statement ok
CREATE INDEX idx1 ON t1 USING HYBRID_INDEX (vec, cat);

statement ok
INSERT INTO t1 SELECT i, 'alpha', list_value(sin(i)::FLOAT, cos(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(1, 51) t(i);

statement ok
INSERT INTO t1 SELECT i, 'beta', list_value(cos(i)::FLOAT, sin(i)::FLOAT, 0.0, 0.0)::FLOATVECTOR(4)
FROM range(51, 101) t(i);

# NO CHECKPOINT
restart

query I
SELECT count(*) FROM t1;
----
100

query I
SELECT count(*) FROM t1 WHERE cat = 'alpha';
----
50

query I
SELECT count(*) FROM t1 WHERE cat = 'beta';
----
50

# Filtered search should work
query I
SELECT count(*) FROM (
  SELECT id FROM t1 WHERE cat = 'alpha'
  ORDER BY l2_distance(vec, [0.0,0.0,0.0,0.0]::FLOATVECTOR(4)) LIMIT 5
);
----
5

query I
SELECT count(*) FROM (
  SELECT id FROM t1 WHERE cat = 'beta'
  ORDER BY l2_distance(vec, [0.0,0.0,0.0,0.0]::FLOATVECTOR(4)) LIMIT 5
);
----
5

# ============================================================
# Test 2: DELETE → restart (no checkpoint) → deletion persists
# ============================================================

statement ok
DELETE FROM t1 WHERE cat = 'alpha' AND id <= 25;

# NO CHECKPOINT
restart

query I
SELECT count(*) FROM t1 WHERE cat = 'alpha';
----
25

query I
SELECT count(*) FROM t1;
----
75

query I
SELECT count(*) FROM (
  SELECT id FROM t1 WHERE cat = 'alpha'
  ORDER BY l2_distance(vec, [0.0,0.0,0.0,0.0]::FLOATVECTOR(4)) LIMIT 5
);
----
5

# ============================================================
# Test 3: INSERT + DELETE → restart (no checkpoint)
# ============================================================

# Insert new partition
statement ok
INSERT INTO t1 SELECT i, 'gamma', list_value(sin(i*0.5)::FLOAT, cos(i*0.5)::FLOAT, 0.1, 0.2)::FLOATVECTOR(4)
FROM range(101, 131) t(i);

# Delete entire beta partition
statement ok
DELETE FROM t1 WHERE cat = 'beta';

# NO CHECKPOINT
restart

query I
SELECT count(*) FROM t1 WHERE cat = 'alpha';
----
25

query I
SELECT count(*) FROM t1 WHERE cat = 'beta';
----
0

query I
SELECT count(*) FROM t1 WHERE cat = 'gamma';
----
30

query I
SELECT count(*) FROM t1;
----
55

# Search on gamma works
query I
SELECT count(*) FROM (
  SELECT id FROM t1 WHERE cat = 'gamma'
  ORDER BY l2_distance(vec, [0.0,0.0,0.0,0.0]::FLOATVECTOR(4)) LIMIT 10
);
----
10

statement ok
DROP TABLE t1;
