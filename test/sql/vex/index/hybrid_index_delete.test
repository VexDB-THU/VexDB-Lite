# name: test/sql/vex/index/hybrid_index_delete.test
# description: Test hybrid index delete and partition operations
# group: [vex]

require vex

statement ok
CREATE TABLE items (id INTEGER, color VARCHAR, vec FLOAT[3]);

statement ok
INSERT INTO items VALUES
  (1, 'red', [1.0, 0.0, 0.0]::FLOAT[3]),
  (2, 'red', [0.9, 0.1, 0.0]::FLOAT[3]),
  (3, 'blue', [0.0, 0.0, 1.0]::FLOAT[3]),
  (4, 'blue', [0.0, 0.1, 0.9]::FLOAT[3]),
  (5, 'green', [0.0, 1.0, 0.0]::FLOAT[3]),
  (6, 'green', [0.1, 0.9, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX idx ON items USING HYBRID_INDEX (vec, color);

# Delete one red item
statement ok
DELETE FROM items WHERE id = 1;

# Search red partition - should find id=2
query I
SELECT id FROM items
WHERE color = 'red'
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3])
LIMIT 1;
----
2

# Delete entire blue partition
statement ok
DELETE FROM items WHERE color = 'blue';

query I
SELECT count(*) FROM items WHERE color = 'blue';
----
0

# Insert new items after delete
statement ok
INSERT INTO items VALUES (7, 'red', [0.95, 0.05, 0.0]::FLOAT[3]);

query I
SELECT id FROM items
WHERE color = 'red'
ORDER BY l2_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3])
LIMIT 1;
----
7

# Cleanup
statement ok
DROP TABLE items;
