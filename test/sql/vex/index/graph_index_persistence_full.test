# name: test/sql/vex/index/graph_index_persistence_full.test
# description: Full persistence lifecycle - checkpoint, restart, insert, re-index
# group: [vex]

require vex

load __TEST_DIR__/graph_index_persistence_full.db

# =============================================================================
# Phase 1: Create table, insert 100 rows, create index
# =============================================================================

statement ok
CREATE TABLE vecs (id INTEGER, vec FLOAT[4]);

statement ok
INSERT INTO vecs SELECT i, [(i * 0.1)::FLOAT, (i * 0.2)::FLOAT, (i * 0.3)::FLOAT, (i * 0.4)::FLOAT]::FLOAT[4] FROM range(100) t(i);

# Verify row count
query I
SELECT COUNT(*) FROM vecs;
----
100

statement ok
CREATE INDEX idx ON vecs USING GRAPH_INDEX (vec);

# Verify index exists
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# =============================================================================
# Phase 2: Verify ANN search works, record top-3 results
# =============================================================================

# Query near origin - row 0 has [0,0,0,0], row 1 has [0.1,0.2,0.3,0.4]
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 3;
----
0
1
2

# Query near a specific point - row 50 should be closest to its own vector
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [5.0, 10.0, 15.0, 20.0]::FLOAT[4]) LIMIT 1;
----
50

# =============================================================================
# Phase 3: CHECKPOINT + restart, verify same top-3 results
# =============================================================================

statement ok
CHECKPOINT;

restart

# Verify index still exists after restart
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# Verify data is intact
query I
SELECT COUNT(*) FROM vecs;
----
100

# Verify same top-3 results after restart
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 3;
----
0
1
2

# Verify the same specific query still works
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [5.0, 10.0, 15.0, 20.0]::FLOAT[4]) LIMIT 1;
----
50

# =============================================================================
# Phase 4: INSERT 50 more rows after restart, verify search finds new rows
# =============================================================================

statement ok
INSERT INTO vecs SELECT 100 + i AS id, [((100 + i) * 0.1)::FLOAT, ((100 + i) * 0.2)::FLOAT, ((100 + i) * 0.3)::FLOAT, ((100 + i) * 0.4)::FLOAT]::FLOAT[4] FROM range(50) t(i);

# Verify count after insert
query I
SELECT COUNT(*) FROM vecs;
----
150

# Search for a newly inserted row's vector - should find itself
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [12.5, 25.0, 37.5, 50.0]::FLOAT[4]) LIMIT 1;
----
125

# Original rows should still be searchable
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 1;
----
0

# =============================================================================
# Phase 5: CHECKPOINT + restart again, verify data integrity
# =============================================================================

statement ok
CHECKPOINT;

restart

# Verify total count is 150
query I
SELECT COUNT(*) FROM vecs;
----
150

# Verify index persisted across second restart
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
1

# Verify search still works across both original and new rows
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 3;
----
0
1
2

query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [12.5, 25.0, 37.5, 50.0]::FLOAT[4]) LIMIT 1;
----
125

# =============================================================================
# Phase 6: DROP INDEX after restart, verify table data still accessible
# =============================================================================

statement ok
DROP INDEX idx;

# Verify index is gone
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx';
----
0

# Table data must still be fully accessible without index
query I
SELECT COUNT(*) FROM vecs;
----
150

# Scan still works (falls back to sequential scan)
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 1;
----
0

# =============================================================================
# Phase 7: CREATE INDEX again, verify it works
# =============================================================================

statement ok
CREATE INDEX idx_new ON vecs USING GRAPH_INDEX (vec);

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'idx_new';
----
1

# Search with the re-created index
query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [0.0, 0.0, 0.0, 0.0]::FLOAT[4]) LIMIT 3;
----
0
1
2

query I
SELECT id FROM vecs ORDER BY l2_distance(vec, [12.5, 25.0, 37.5, 50.0]::FLOAT[4]) LIMIT 1;
----
125

# Cleanup
statement ok
DROP TABLE vecs;
