# name: test/sql/vex/types/floatvector_dims.test
# description: Test vector dimension constraints
# group: [vex]

require vex

# Zero dimension should fail (DuckDB native check)
statement error
CREATE TABLE t_bad (v FLOAT[0]);
----

# Large valid dimension
statement ok
CREATE TABLE t_large (v FLOAT[4096]);

# Very large dimension still works with FLOAT[N] (DuckDB native array)
statement ok
CREATE TABLE t_huge (v FLOAT[16384]);
