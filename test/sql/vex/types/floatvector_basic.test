# name: test/sql/vex/types/floatvector_basic.test
# description: Test FLOATVECTOR type basics
# group: [vex]

require vex

# Basic type creation and usage
statement ok
CREATE TABLE t1 (id INT, embedding FLOATVECTOR(3));

statement ok
INSERT INTO t1 VALUES (1, [1.0, 2.0, 3.0]::FLOATVECTOR(3));

statement ok
INSERT INTO t1 VALUES (2, [4.0, 5.0, 6.0]::FLOATVECTOR(3));

query II
SELECT id, embedding FROM t1 ORDER BY id;
----
1	[1.0, 2.0, 3.0]
2	[4.0, 5.0, 6.0]

# Dimension mismatch on insert should fail
statement error
INSERT INTO t1 VALUES (3, [1.0, 2.0]::FLOATVECTOR(2));
----

# Single dimension vector
statement ok
CREATE TABLE t2 (v FLOATVECTOR(1));

statement ok
INSERT INTO t2 VALUES ([42.0]::FLOATVECTOR(1));

query I
SELECT v FROM t2;
----
[42.0]

# NULL handling
statement ok
INSERT INTO t1 VALUES (4, NULL);

query II
SELECT id, embedding FROM t1 WHERE embedding IS NULL;
----
4	NULL
