#if (defined(PG_VEXDB_TARGET_DUCK) || defined(PG_VEXDB_TARGET_SQLITE))
using MemoryContext = void *;
static constexpr MemoryContext CurrentMemoryContext = nullptr;
inline MemoryContext MemoryContextSwitchTo(MemoryContext ctx) { return ctx; }
inline void *palloc(size_t size) { return std::malloc(size); }
inline void *palloc0(size_t size) {
    void *ptr = std::calloc(1, size);
    if (!ptr) {
        throw std::bad_alloc();
    }
    return ptr;
}
inline void *repalloc(void *ptr, size_t size) {
    void *new_ptr = std::realloc(ptr, size);
    if (!new_ptr) {
        throw std::bad_alloc();
    }
    return new_ptr;
}
inline void pfree(void *ptr) { std::free(ptr); }
/* MemoryContextAlloc 由 vexdb-duck/include/duck_pg_shim.hpp:56 提供 (避免重定义).
 * 这里补 MemoryContextAllocZero — b042c2c827 引入, duck_pg_shim.hpp 未提供, 否则
 * 编 graph_index_algorithm.h:148 的 Vector<ItemPointerData> temp 时找不到. */
#if defined(PG_VEXDB_TARGET_SQLITE)
inline void *MemoryContextAlloc(MemoryContext /*ctx*/, size_t size) { return palloc(size); }
#endif
inline void *MemoryContextAllocZero(MemoryContext /*ctx*/, size_t size) { return palloc0(size); }
inline void *palloc_aligned(size_t size, size_t align, int /*flags*/) {
    void *ptr = nullptr;
    if (posix_memalign(&ptr, align, size) != 0 || !ptr) {
        throw std::bad_alloc();
    }
    return ptr;
}
