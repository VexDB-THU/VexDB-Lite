FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        fuse3 \
        git \
        libfuse3-dev \
        libpq-dev \
        postgresql-client \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
